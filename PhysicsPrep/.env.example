# 复制为 .env 后按学校提供的实际值填写。
# 三个变量（KEY / BASE_URL / MODEL）任一为空，系统自动使用 Mock 模式，全部核心功能仍可用。

# 上海科技大学 GenAI API Key（不要提交到仓库）
GENAI_API_KEY=

# 学校提供的实际 API Address，例如 https://<学校域名>/v1
# 必须是 https；不要猜测模型 ID。
GENAI_BASE_URL=

# 学校实际提供的模型 ID（界面里也可临时修改，密钥始终只从这里读）
GENAI_MODEL=

# 单次请求超时（秒）与最大重试次数（指数退避）
GENAI_TIMEOUT=60
GENAI_MAX_RETRIES=2

# true = 强制离线 Mock，不发起任何网络请求
APP_MOCK_MODE=false

# 可选：数据库文件位置（默认为 data/physics_prep.sqlite3）
# PHYSICSPREP_DB_PATH=

# 可选：监听端口（默认 7860，始终只绑定 127.0.0.1）
# PHYSICSPREP_PORT=7860

# 可选：启动时自动打开浏览器（默认 false）
# PHYSICSPREP_OPEN_BROWSER=false
