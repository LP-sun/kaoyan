# ============================================================
# fastgpt-physics-lab — 环境变量模板
# ------------------------------------------------------------
# 用法：
#   1. 复制本文件为同目录下的 .env       (cp env/.env.example env/.env)
#   2. 只填写「必填」段落，其余保持默认或自行生成随机值
#   3. .env 已在 .gitignore 中，绝不要提交、截图或粘贴到聊天
# ============================================================
#
# 主机端口规划（全部仅绑定 127.0.0.1，不暴露到局域网/公网）：
#   3100  FastGPT Web 控制台 / 对话界面        (容器内 3000)  ← 按任务要求优先使用
#   3102  Agent Sandbox Proxy（本地 WebSocket，容器内 1006）
#   3101  本项目「诊断工作流」本地服务（非 FastGPT，见 tools/diagnosis-server.mjs）
#   3103  备用：FastGPT Web 的第二方案端口（若 3100 被占用）
#
# 端口选择说明（含一次实测纠错）：
#   早期测得 3100 的 bind 返回 EACCES，当时判断为"平台策略禁止绑定"并改用 3101。
#   后续复测（连续 15 次 bind/close 全部成功，并完成一次真实 HTTP 请求）表明
#   3100 **可以正常使用**，先前的结论是错的。现按要求改回 3100。
#   为避免与 3100 相邻冲突，本地诊断服务从 3103 调整为 3101。
# ============================================================


# ============================================================
# 一、必填：上海科技大学 GenAI API（OpenAI 兼容）
# ------------------------------------------------------------
# 请从学校 GenAI 平台获取，不要使用任何示例值。
# 若学校接口是 OpenAI 兼容的 /v1/chat/completions，BASE_URL 通常形如：
#     https://<学校网关域名>/v1
# 注意：BASE_URL 是否要带 /v1 取决于学校网关；脚本会自动尝试两种形式。
#
# ------------------------------------------------------------
# 两个候选服务商的**实测探测结果**（仅探测端点形态，未使用任何真实密钥）
# ------------------------------------------------------------
#
# 【推荐先用】并行科技 LLM API
#     GENAI_BASE_URL = https://llmapi.paratera.com/v1
#   实测证据：
#     GET  /v1/models           -> 401 OpenAI 风格鉴权错误（端点存在且路径正确）
#     GET  /v1/chat/completions -> 405 Method Not Allowed（路径存在，只是要 POST）
#   错误体形如 {"error":{"message":"Authentication Error, Invalid proxy server token ...",
#                        "type":"token_not_found_in_db"}}
#   ★ 结论：后端是 **LiteLLM** 代理，**严格 OpenAI 兼容**，FastGPT 可直接对接。
#     这是目前唯一"已确认能直接对接"的端点，建议先用它跑通全流程。
#
# 【上科大网关】genaiapi.shanghaitech.edu.cn
#     GENAI_BASE_URL 候选 = https://genaiapi.shanghaitech.edu.cn/api/v1
#   实测证据：
#     POST /api/v1/start -> 401 {"error":{"message":"错误的api-key",
#                              "type":"authentication_error","code":"invalid_api_key"}}
#       → 该路径是**真实 API**，且返回 **OpenAI 风格错误体**，说明它确实属于一个
#         OpenAI 兼容网关（必须 POST；GET 会返回 404）。
#     /api/v1/chat/completions、/api/v1/models、/api/v1/completions、
#     /api/v1/embeddings                -> 404（这些路径不存在）
#     不带 /api 的 /v1/*、/models、/chat/completions
#                                       -> 200 但返回
#                                          {"success":false,"message":"Token失效，请重新登录"}
#                                          （这是前端网页应用的路由，不是 API）
#   ★ 结论：该网关暴露的路径与标准 OpenAI 不同，**没有 /models 端点**
#     （因此无法通过接口列出模型 ID）；已探到的唯一真实端点名为 `start`，
#     在没有真实密钥的情况下我无法确定它接受什么请求体。
#     请从学校平台的使用说明确认调用示例：若文档给出的就是 /api/v1/start 这类
#     自定义接口，则它**不是**标准 OpenAI 格式，FastGPT 不能直接对接（需协议适配层）。
#
#   注意：上科大还有个页面域名 https://genai.shanghaitech.edu.cn
#         它对所有路径都返回前端 HTML（SPA catch-all），不是 API。
#         真正的 API 域名是 https://genaiapi.shanghaitech.edu.cn
# ============================================================

# 必填：API 地址（由学校提供）
GENAI_BASE_URL=

# 必填：API Key（由学校提供）
GENAI_API_KEY=

# 必填：模型 ID（由学校提供，例如 gpt-4o-mini / deepseek-chat / qwen-plus 等实际名称）
# 并行科技账户的推荐值（经真实工作流同构基准评测，见 FASTGPT_DEPLOY_REPORT.md 第九节）：
#   DeepSeek-V4-Flash   12 分 / 5.4s / 1元输入 + 2元输出 每百万 token ← 性价比最优
#   Kimi-K2.6           12 分 / 4.2s / 6.5元 + 27元
#   GLM-5.3-Flash       10 分 / 23.5s / 0.4元 + 1.4元 ← 最便宜但思维链长、延迟高
GENAI_MODEL=

# 可选：备用模型 ID（逗号分隔），连通性测试脚本会依次尝试
# 推荐：DeepSeek-V4.1-Flash,Kimi-K2.6,Qwen3.8-Flash
GENAI_MODEL_FALLBACKS=

# 可选：Embedding 模型 ID。学校若未提供 Embedding 接口，请留空。
# 留空时 FastGPT 的知识库向量检索不可用，但对话/工作流/交互节点不受影响。
# 注意：上海科技大学网关**不提供** embeddings 接口（实测 /embeddings 会被路由到
# /chat/completions 并报缺 messages），用它时必须留空。并行科技可填 GLM-Embedding-3。
GENAI_EMBEDDING_MODEL=

# 可选：请求超时（秒）。学校网关首次调用可能超过 30 秒（冷启动），建议 60。
GENAI_TIMEOUT=

# 可选：失败重试次数。网络抖动时建议 2。
GENAI_MAX_RETRIES=


# ============================================================
# 二、FastGPT 应用配置
# ============================================================

# 客户端访问 FastGPT 使用的地址，由 协议://主机:端口 组成，结尾不要带斜杠。
# 本项目仅本机访问，因此固定为 127.0.0.1 + FASTGPT_HOST_PORT。
FE_DOMAIN=http://127.0.0.1:3100

# FastGPT Web 在宿主机上的端口（默认 3100；若被占用改为 3103 等并同步修改 FE_DOMAIN）
FASTGPT_HOST_PORT=3100

# Sandbox Proxy 在宿主机上的端口
SANDBOX_PROXY_HOST_PORT=3102

# MinIO 对象存储控制台端口；默认不映射。若确需使用控制台，改成如 127.0.0.1:9101:9001
# 并把 docker-compose.yml 里 fastgpt-minio 的 ports 段落取消注释。
MINIO_CONSOLE_BIND=127.0.0.1:9101

# root 账号的初始登录密码（用户名固定为 root）。重启会按此值重置，请务必修改。
DEFAULT_ROOT_PSW=change-me-root-password

# 系统最高权限密钥（客户端调用 FastGPT OpenAPI 时使用），至少 32 位随机串
ROOT_KEY=change-me-root-key-min-32-chars


# ============================================================
# 三、内部服务密钥 / 密码
# ------------------------------------------------------------
# 这些只在本 Compose 私有网络内使用，不会向宿主机公开端口。
# 下面的值是占位符，请替换为随机串（可用 tools/new-secrets.mjs 生成）。
# 注意：MongoDB 密码不要包含 @ : / 等 URL 保留字符。
# ============================================================

MONGO_ROOT_USERNAME=fgphysics
MONGO_ROOT_PASSWORD=change-me-mongo-password
REDIS_PASSWORD=change-me-redis-password

PG_VECTOR_USER=fgphysics
PG_VECTOR_PASSWORD=change-me-pg-password

MINIO_ROOT_USER=fgphysics-minio
MINIO_ROOT_PASSWORD=change-me-minio-password

# 以下四项必须是随机串，且 FastGPT 与对应容器保持一致（compose 已自动注入，无需手改）
FILE_TOKEN_KEY=change-me-file-token-key
AES256_SECRET_KEY=change-me-aes256-secret-key
INVOKE_TOKEN_SECRET=change-me-invoke-token-secret-min-32-chars
AGENT_SANDBOX_PROXY_SECRET=change-me-agent-sandbox-proxy-secret-min-32
PLUGIN_TOKEN=change-me-plugin-auth-token
CONNECTION_GATEWAY_AUTH_TOKEN=change-me-connection-gateway-token-placeholder-32
CODE_SANDBOX_TOKEN=change-me-code-sandbox-token
AIPROXY_API_TOKEN=change-me-aiproxy-token
AIPROXY_API_ENDPOINT=http://fastgpt-agent-sandbox-proxy:1006


# ============================================================
# 四、本项目「原生诊断工作流」配置（tools/ 目录，非 FastGPT）
# ============================================================

# 原生诊断服务监听地址与端口（仅回环）
DIAG_HOST=127.0.0.1
DIAG_PORT=3101

# 单次诊断最多出题数
DIAG_MAX_QUESTIONS=10

# 是否启用 GenAI 错因分析（true/false）。false 时仅使用固定答案判分。
DIAG_ENABLE_LLM=true
