[{"box": [[534.9863891601562, 236.47227478027344], [982.3369750976562, 236.47227478027344], [982.3369750976562, 280.4909362792969], [534.9863891601562, 280.4909362792969]], "text": "第一章光和光的传播", "confidence": 0.9998486571841769}, {"box": [[607.3369750976562, 337.8175354003906], [914.0625, 334.7464599609375], [914.0625, 375.6940612792969], [607.3369750976562, 378.7651062011719]], "text": "81.光和光学", "confidence": 0.9643112421035767}, {"box": [[234.375, 441.2101745605469], [423.9130554199219, 443.257568359375], [423.9130554199219, 474.991943359375], [234.375, 472.9445495605469]], "text": "1.1光的本性", "confidence": 0.9996615477970668}, {"box": [[299.5924072265625, 499.56048583984375], [1277.853271484375, 498.53680419921875], [1277.853271484375, 529.2474975585938], [299.5924072265625, 530.2711791992188]], "text": "光是-一种重要的自然现象。我们所以能够看到客观世界中斑驳陆离、瞬", "confidence": 0.9742552954703569}, {"box": [[236.4130401611328, 548.6975708007812], [1276.834228515625, 548.6975708007812], [1276.834228515625, 578.3845825195312], [236.4130401611328, 578.3845825195312]], "text": "息万变的景象，是因为眼睛接收物体发射、反射或散射的光。据统计，人类感", "confidence": 0.9900746888974133}, {"box": [[236.4130401611328, 598.8583374023438], [1276.834228515625, 598.8583374023438], [1276.834228515625, 628.5453491210938], [236.4130401611328, 628.5453491210938]], "text": "官收到外部世界的总信息量中，至少有90%以上是通过眼睛的。由于光与", "confidence": 0.9909381577462861}, {"box": [[234.375, 646.9717407226562], [1276.834228515625, 647.9954833984375], [1276.834228515625, 678.7061157226562], [234.375, 677.6824340820312]], "text": "人类生活和社会实践的密切联系，光学也和天文学、几何学、力学一样，是一", "confidence": 0.9957043405841378}, {"box": [[234.375, 695.085205078125], [1276.834228515625, 697.132568359375], [1276.834228515625, 727.84326171875], [234.375, 725.7958374023438]], "text": "门最早发展起来的学科。然而，在很长一个历史时期里，人类的光学知识仅", "confidence": 0.9952785083741853}, {"box": [[236.4130401611328, 745.2459716796875], [1275.815185546875, 745.2459716796875], [1275.815185546875, 774.9329833984375], [236.4130401611328, 774.9329833984375]], "text": "限于一些现象和简单规律的描述。对光的本性的认真探讨，应该说是从17", "confidence": 0.9984627618934169}, {"box": [[236.4130401611328, 796.430419921875], [1276.834228515625, 796.430419921875], [1276.834228515625, 826.117431640625], [236.4130401611328, 826.117431640625]], "text": "世纪开始的，当时有两个学说并立。一方面，以牛顿为代表的一些人提出了", "confidence": 0.9987189300132521}, {"box": [[234.375, 844.5438232421875], [1276.834228515625, 846.5912475585938], [1276.834228515625, 876.2781982421875], [234.375, 874.2308349609375]], "text": "微粒理论，认为光是按照惯性定律沿直线飞行的微粒流。这个学说直接说明", "confidence": 0.9969092806180319}, {"box": [[236.4130401611328, 893.6809692382812], [1276.834228515625, 894.7046508789062], [1276.834228515625, 925.4153442382812], [236.4130401611328, 924.3916015625]], "text": "了光的直线传播定律，并能对光的反射和折射作一定的解释（见4.3节）。但", "confidence": 0.9958047304834639}, {"box": [[234.375, 942.8180541992188], [1276.834228515625, 944.8654174804688], [1276.834228515625, 975.5761108398438], [234.375, 973.5287475585938]], "text": "是，用微粒说研究光的折射定律时，得出了光在水中的速度比空气中大的错", "confidence": 0.9984582608396356}, {"box": [[234.375, 991.9551391601562], [1275.815185546875, 994.0025024414062], [1275.815185546875, 1024.7132568359375], [234.375, 1022.6658325195312]], "text": "误结论。不过这一点在当时的科学技术条件下还不能通过实验测定来鉴别。", "confidence": 0.9975502400687246}, {"box": [[233.35598754882812, 1040.0684814453125], [1276.834228515625, 1043.1396484375], [1276.834228515625, 1073.850341796875], [233.35598754882812, 1070.7791748046875]], "text": "光的微粒理论差不多统治了17、18两个世纪。另一方面，和牛顿同时代的惠", "confidence": 0.9972908735275269}, {"box": [[233.35598754882812, 1090.2293701171875], [1276.834228515625, 1093.3004150390625], [1276.834228515625, 1124.0111083984375], [233.35598754882812, 1120.9400634765625]], "text": "更斯（C.Huygens）提出了光的波动理论，认为光是在一种特殊弹性介质中", "confidence": 0.9928572419527415}, {"box": [[233.35598754882812, 1139.366455078125], [1276.834228515625, 1142.4375], [1276.834228515625, 1173.148193359375], [233.35598754882812, 1170.0771484375]], "text": "传播的机械波。这理论也解释了光的反射和折射等现象（见3.3节）。然而惠", "confidence": 0.9959748915263584}, {"box": [[233.35598754882812, 1187.4798583984375], [1276.834228515625, 1191.5745849609375], [1276.834228515625, 1222.2852783203125], [233.35598754882812, 1218.1905517578125]], "text": "更斯认为光是纵波，他的理论是很不完善的。19世纪初，托马斯·杨", "confidence": 0.9947915173345997}, {"box": [[233.35598754882812, 1237.640625], [1277.853271484375, 1238.664306640625], [1277.853271484375, 1272.446044921875], [233.35598754882812, 1271.42236328125]], "text": "（ThomasYoung）和菲涅耳（A.J.Fresnel）等人的实验和理论工作把光的", "confidence": 0.9972597069518511}, {"box": [[233.35598754882812, 1286.7777099609375], [1276.834228515625, 1289.8487548828125], [1276.834228515625, 1320.5594482421875], [233.35598754882812, 1317.4884033203125]], "text": "波动理论大大推向前进，解释了光的干涉、衍射现象，初步测定了光的波长，", "confidence": 0.9957676950623008}, {"box": [[232.3369598388672, 1333.867431640625], [1277.853271484375, 1340.009521484375], [1277.853271484375, 1372.767578125], [232.3369598388672, 1366.62548828125]], "text": "并根据光的偏振现象确认光是横波（有关光的波动理沦，参见第三、四、五", "confidence": 0.9776544552860837}, {"box": [[232.3369598388672, 1386.0755615234375], [1276.834228515625, 1390.17041015625], [1276.834228515625, 1420.8809814453125], [232.3369598388672, 1416.7862548828125]], "text": "各章）。用光的波动理论研究光的折射，得出的结论是光在水中的速度应小", "confidence": 0.9978329954725323}, {"box": [[232.3369598388672, 1434.18896484375], [1277.853271484375, 1439.3074951171875], [1277.853271484375, 1472.0655517578125], [232.3369598388672, 1466.947021484375]], "text": "于它在空气中的速度,这一点在1862年为傅科（J.B.L.Foucault）的实验", "confidence": 0.9817163958782102}, {"box": [[233.35598754882812, 1484.3497314453125], [1276.834228515625, 1489.46826171875], [1276.834228515625, 1520.178955078125], [233.35598754882812, 1515.0604248046875]], "text": "所证实。因此，19世纪中叶，光的波动说战胜了微粒说，在比较坚实的基础", "confidence": 0.9923546524608836}, {"box": [[231.31793212890625, 1531.439453125], [414.7418518066406, 1533.4869384765625], [414.7418518066406, 1567.2686767578125], [231.31793212890625, 1565.2213134765625]], "text": "上确立起来。", "confidence": 0.9999403655529022}, {"box": [[297.5543518066406, 1582.6240234375], [1274.7962646484375, 1587.742431640625], [1274.7962646484375, 1617.429443359375], [297.5543518066406, 1612.31103515625]], "text": "惠更斯一菲涅耳旧波动理论的弱点，和微粒理论一样，在于它们都带有", "confidence": 0.9850647968630637}, {"box": [[231.31793212890625, 1630.7374267578125], [1276.834228515625, 1636.8795166015625], [1276.834228515625, 1667.5902099609375], [231.31793212890625, 1661.4481201171875]], "text": "机械论的色彩，把光现象看成某种机械运动过程。认为光是一种弹性波，就", "confidence": 0.9960453221292207}, {"box": [[230.29891967773438, 1678.850830078125], [1275.815185546875, 1686.0166015625], [1275.815185546875, 1718.774658203125], [230.29891967773438, 1711.60888671875]], "text": "必须臆想一种特殊的弹性介质[历史上叫做“以太（aether）”]充满空间。", "confidence": 0.9637349505682249}, {"box": [[230.29891967773438, 1730.0352783203125], [1273.7772216796875, 1737.2010498046875], [1273.7772216796875, 1766.8880615234375], [230.29891967773438, 1759.7222900390625]], "text": "为了不与观测事实抵触，还必须赋予以太极其矛盾的属性：密度极小和弹", "confidence": 0.9974393341690302}, {"box": [[230.29891967773438, 1779.17236328125], [1273.7772216796875, 1786.338134765625], [1273.7772216796875, 1817.048828125], [230.29891967773438, 1809.883056640625]], "text": "性模量极大。这不仅在实验上无法得到证实，理论上也显得荒唐。重要的突", "confidence": 0.9987734574260134}, {"box": [[229.27989196777344, 1827.2857666015625], [1276.834228515625, 1833.4278564453125], [1276.834228515625, 1866.1859130859375], [229.27989196777344, 1860.0438232421875]], "text": "破发生在19世纪60年代。麦克斯韦（J.C.Maxwell）在前人的基础上，建", "confidence": 0.9901283536201868}]