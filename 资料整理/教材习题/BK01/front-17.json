[{"box": [[185.4619598388672, 123.8664321899414], [210.9375, 123.8664321899414], [210.9375, 154.57711791992188], [185.4619598388672, 154.57711791992188]], "text": "2", "confidence": 0.9923357367515564}, {"box": [[570.6521606445312, 123.8664321899414], [829.4837036132812, 123.8664321899414], [829.4837036132812, 151.50604248046875], [570.6521606445312, 151.50604248046875]], "text": "第一章光和光的传播", "confidence": 0.947086062696245}, {"box": [[178.3288116455078, 207.80897521972656], [1219.76904296875, 205.7615966796875], [1219.76904296875, 235.44859313964844], [178.3288116455078, 237.4959716796875]], "text": "立起他著名的电磁理论。这个理论预言了电磁波的存在，并指出电磁波的速", "confidence": 0.9964603113405632}, {"box": [[176.29075622558594, 254.898681640625], [1220.7880859375, 253.875], [1220.7880859375, 284.585693359375], [176.29075622558594, 285.609375]], "text": "度与光速相同。因此麦克斯韦确信光是一种电磁现象，即波长较短的电磁", "confidence": 0.9910206384956837}, {"box": [[177.30978393554688, 303.0120849609375], [1219.76904296875, 303.0120849609375], [1219.76904296875, 333.7227783203125], [177.30978393554688, 333.7227783203125]], "text": "波。1888年赫兹（H.R.Hertz）实验发现了波长较长的电磁波一无线电", "confidence": 0.9899265750034435}, {"box": [[178.3288116455078, 353.1728820800781], [1218.75, 353.1728820800781], [1218.75, 382.85986328125], [178.3288116455078, 382.85986328125]], "text": "波，它有反射、折射、干涉、衍射等与光波类似的性质。后来的科学实验又", "confidence": 0.9940657814343771}, {"box": [[177.30978393554688, 402.3099670410156], [1218.75, 402.3099670410156], [1218.75, 431.9969787597656], [177.30978393554688, 431.9969787597656]], "text": "证明，红外线、紫外线和X射线等也都是电磁波，它们彼此的区别只是波长", "confidence": 0.9886580886262836}, {"box": [[176.29075622558594, 449.3996887207031], [1120.9239501953125, 451.44708251953125], [1120.9239501953125, 481.1340637207031], [176.29075622558594, 479.0867004394531]], "text": "不同而已。光的电磁理论以大量无可辩驳的事实赢得了普通的公认。", "confidence": 0.9968651354312896}, {"box": [[242.5271759033203, 497.5130920410156], [1218.75, 499.56048583984375], [1218.75, 529.2474975585938], [242.5271759033203, 527.2000732421875]], "text": "以上是经典物理学中光的微粒说与波动说之争的简短回顾，其中讨论", "confidence": 0.9987594922383626}, {"box": [[176.29075622558594, 545.6265258789062], [1218.75, 548.6975708007812], [1218.75, 579.4082641601562], [176.29075622558594, 576.3372192382812]], "text": "的主要是光的传播，很少涉及光的发射和吸收。那时期光和物质的相互作用", "confidence": 0.9987153428973574}, {"box": [[175.27174377441406, 594.7636108398438], [794.8369750976562, 596.8109741210938], [794.8369750976562, 627.5216674804688], [175.27174377441406, 625.4743041992188]], "text": "问题还没有怎么研究过，许多现象尚未发现。", "confidence": 0.9987515538930893}, {"box": [[238.4510955810547, 643.9006958007812], [1216.7119140625, 646.9717407226562], [1216.7119140625, 677.6824340820312], [238.4510955810547, 674.6113891601562]], "text": "19世纪末、20世纪初是物理学发生伟大革命的时代。从牛顿力学到麦", "confidence": 0.9987740479409695}, {"box": [[176.29075622558594, 693.0377807617188], [1217.73095703125, 697.132568359375], [1217.73095703125, 726.819580078125], [176.29075622558594, 722.7247924804688]], "text": "克斯韦的电磁理论，经典物理学形成一套严整的理论体系。当时绝大部分物", "confidence": 0.9981008244283271}, {"box": [[174.25271606445312, 742.1748657226562], [1218.75, 746.2696533203125], [1218.75, 775.9566650390625], [174.25271606445312, 771.8618774414062]], "text": "理学家深信，物理学中各种基本问题在原则上都已得到完美的解决，它的理", "confidence": 0.9973651351350726}, {"box": [[174.25271606445312, 789.2645874023438], [1217.73095703125, 795.40673828125], [1217.73095703125, 825.09375], [174.25271606445312, 818.9515991210938]], "text": "论体系囊括了一切物理现象的基本规律，剩下的似乎只是解微分方程和具", "confidence": 0.9962075091898441}, {"box": [[174.25271606445312, 838.4017333984375], [1216.7119140625, 843.5201416015625], [1216.7119140625, 874.2308349609375], [174.25271606445312, 869.1123657226562]], "text": "体应用的问题了。然而，正当人们欢庆这宏伟的经典物理学大厦落成的时", "confidence": 0.9973041489720345}, {"box": [[174.25271606445312, 888.5625], [1217.73095703125, 892.6572265625], [1217.73095703125, 923.367919921875], [174.25271606445312, 919.273193359375]], "text": "候，一个个使经典物理学理论陷人窘境的惊人发现接而来。1887年迈克", "confidence": 0.996080239613851}, {"box": [[172.2146759033203, 936.6759033203125], [1215.6929931640625, 941.7943725585938], [1215.6929931640625, 972.5050048828125], [172.2146759033203, 967.3865966796875]], "text": "耳孙（A..A.Michelson）和莫雷（E.W.Morley）利用光的干涉效应，试图", "confidence": 0.992340701547536}, {"box": [[173.23370361328125, 984.789306640625], [1216.7119140625, 990.9314575195312], [1216.7119140625, 1020.6184692382812], [173.23370361328125, 1014.476318359375]], "text": "探测地球在“以太”中的绝对运动。他们得到否定的结果，从而动摇了作为", "confidence": 0.9958755789381085}, {"box": [[173.23370361328125, 1033.9263916015625], [1215.6929931640625, 1039.0447998046875], [1215.6929931640625, 1068.7318115234375], [173.23370361328125, 1063.6134033203125]], "text": "光波（电磁波）载体的“以太”假说，以“静止以太”为背景的绝对时空观遇", "confidence": 0.9945705199942869}, {"box": [[171.19564819335938, 1081.01611328125], [1217.73095703125, 1085.11083984375], [1217.73095703125, 1118.892578125], [171.19564819335938, 1114.7978515625]], "text": "到了根本性的困难。随后瑞利（J.W.S.Rayleigh）和金斯（J.H.Jeans）根", "confidence": 0.9973293705420061}, {"box": [[172.2146759033203, 1131.1768798828125], [1215.6929931640625, 1137.319091796875], [1215.6929931640625, 1167.0059814453125], [172.2146759033203, 1160.8638916015625]], "text": "据经典统计力学和电磁波理论，导出黑体辐射公式，该公式要求辐射能量随", "confidence": 0.9965543349583944}, {"box": [[171.19564819335938, 1179.290283203125], [1212.6358642578125, 1186.4561767578125], [1212.6358642578125, 1217.1668701171875], [171.19564819335938, 1210.0009765625]], "text": "频率的增长而趋于无穷大。当时物理学界的权威开耳文爵士（LordKelvin）", "confidence": 0.9928102273690073}, {"box": [[171.19564819335938, 1228.4273681640625], [1214.6739501953125, 1235.59326171875], [1214.6739501953125, 1266.303955078125], [171.19564819335938, 1259.1380615234375]], "text": "把光以太和能均分定理的困难比喻作笼罩在物理学晴朗天空中的两朵乌", "confidence": 0.9855653778199227}, {"box": [[173.23370361328125, 1276.540771484375], [1214.6739501953125, 1283.7066650390625], [1214.6739501953125, 1314.4173583984375], [173.23370361328125, 1307.25146484375]], "text": "云。从后来物理学的发展看来，这两朵“乌云”正预示着近代物理学两个革", "confidence": 0.9966319293686838}, {"box": [[171.19564819335938, 1325.6778564453125], [1214.6739501953125, 1333.867431640625], [1214.6739501953125, 1364.578125], [171.19564819335938, 1356.3885498046875]], "text": "命性的重大理论-一相对论和量子论的诞生。有趣的是，这两个问题恰好", "confidence": 0.993302721530199}, {"box": [[170.1766357421875, 1373.791259765625], [384.17120361328125, 1375.8387451171875], [384.17120361328125, 1407.5731201171875], [170.1766357421875, 1405.525634765625]], "text": "都与光学有关。", "confidence": 0.9999354651996067}, {"box": [[234.375, 1424.975830078125], [1216.7119140625, 1432.1416015625], [1216.7119140625, 1462.852294921875], [234.375, 1455.6865234375]], "text": "现在让我们回到光的本性问题上来。为了解决黑体辐射理论中的矛盾，", "confidence": 0.9992023744890767}, {"box": [[169.15760803222656, 1472.0655517578125], [1213.6549072265625, 1481.2786865234375], [1213.6549072265625, 1511.9893798828125], [169.15760803222656, 1502.7762451171875]], "text": "1900年普朗克（M.Planck）提出了量子假说，认为各种频率的电磁波（包括", "confidence": 0.9949572560114738}, {"box": [[168.1385955810547, 1521.20263671875], [1214.6739501953125, 1530.415771484375], [1214.6739501953125, 1560.102783203125], [168.1385955810547, 1550.8896484375]], "text": "光），只能像微粒似地以一定最小份额的能量（称为能量子）发生。这是一个", "confidence": 0.9976270146229688}, {"box": [[168.1385955810547, 1569.3160400390625], [1212.6358642578125, 1577.5054931640625], [1212.6358642578125, 1608.2161865234375], [168.1385955810547, 1600.0267333984375]], "text": "光的发射问题。另-个显示光的微粒性的重要发现是光电效应，即光照射在", "confidence": 0.9830218544512084}, {"box": [[167.11956787109375, 1617.429443359375], [1212.6358642578125, 1626.642578125], [1212.6358642578125, 1657.353271484375], [167.11956787109375, 1648.14013671875]], "text": "金属表面上可使电子逸出，逸出电子的能量与光的强度无关，但与光的频率", "confidence": 0.9982698957125345}, {"box": [[166.1005401611328, 1666.5665283203125], [1211.6168212890625, 1674.7559814453125], [1211.6168212890625, 1705.4666748046875], [166.1005401611328, 1697.2772216796875]], "text": "有关，这是～一个光的吸收问题。1905年爱因斯坦发展了光的量子理论，成功", "confidence": 0.9776850557989545}, {"box": [[166.1005401611328, 1715.70361328125], [1210.5977783203125, 1723.8931884765625], [1210.5977783203125, 1754.603759765625], [166.1005401611328, 1746.414306640625]], "text": "地解释了这个效应。光究竟是微粒还是波动？这个古老的争论重新摆在了", "confidence": 0.9917419273406267}, {"box": [[166.1005401611328, 1763.8170166015625], [387.228271484375, 1766.8880615234375], [387.228271484375, 1798.6224365234375], [166.1005401611328, 1795.5513916015625]], "text": "我们的面前。", "confidence": 0.999609132607778}, {"box": [[231.31793212890625, 1813.977783203125], [1211.6168212890625, 1822.1673583984375], [1211.6168212890625, 1852.8780517578125], [231.31793212890625, 1844.6884765625]], "text": "其实，“粒子”和“波动”都是经典物理的概念。近代科学实践证明，光", "confidence": 0.9963323846459389}]