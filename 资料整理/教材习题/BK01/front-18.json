[{"box": [[656.25, 121.81905364990234], [856.997314453125, 121.81905364990234], [856.997314453125, 152.5297393798828], [656.25, 152.5297393798828]], "text": "81.光和光学", "confidence": 0.982975959777832}, {"box": [[1241.16845703125, 122.84274291992188], [1266.64404296875, 122.84274291992188], [1266.64404296875, 153.5534210205078], [1241.16845703125, 153.5534210205078]], "text": "3", "confidence": 0.9988970756530762}, {"box": [[232.3369598388672, 205.7615966796875], [1272.7581787109375, 205.7615966796875], [1272.7581787109375, 235.44859313964844], [232.3369598388672, 235.44859313964844]], "text": "是个十分复杂的客体。对于它的本性问题，只能用它所表现的性质和规律来", "confidence": 0.997911502014507}, {"box": [[232.3369598388672, 253.875], [1271.7391357421875, 254.898681640625], [1271.7391357421875, 284.585693359375], [232.3369598388672, 283.5619812011719]], "text": "回答：光的某些方面的行为像经典的“波动”，另一些方面的行为却像经典", "confidence": 0.9946063612446641}, {"box": [[229.27989196777344, 300.9647216796875], [1272.7581787109375, 303.0120849609375], [1272.7581787109375, 333.7227783203125], [229.27989196777344, 331.6754150390625]], "text": "的“粒子”。这就是所谓“光的波粒二象性”。任何经典的概念都不能完全概", "confidence": 0.9918440036913928}, {"box": [[230.29891967773438, 350.101806640625], [413.72283935546875, 350.101806640625], [413.72283935546875, 380.8125], [230.29891967773438, 380.8125]], "text": "括光的本性。", "confidence": 0.9997808833916982}, {"box": [[226.2228240966797, 401.2862854003906], [450.4076232910156, 405.38104248046875], [450.4076232910156, 439.1628112792969], [226.2228240966797, 435.06805419921875]], "text": "1.2光源与光谱", "confidence": 0.9994286298751831}, {"box": [[294.4972839355469, 461.6839599609375], [1271.7391357421875, 466.80242919921875], [1271.7391357421875, 497.5130920410156], [294.4972839355469, 492.3946533203125]], "text": "任何发光的物体都可叫做光源。太阳、腊烛的火焰、钨丝白炽灯、日光", "confidence": 0.9968937789240191}, {"box": [[227.24185180664062, 507.75], [1270.7200927734375, 514.9158325195312], [1270.7200927734375, 545.6265258789062], [227.24185180664062, 538.460693359375]], "text": "灯、水银灯，都是我们日常生活中熟悉的光源。光源不仅用来照明，在实验室", "confidence": 0.9951608514084536}, {"box": [[229.27989196777344, 556.8870849609375], [1271.7391357421875, 563.0292358398438], [1271.7391357421875, 593.7399291992188], [229.27989196777344, 587.5977783203125]], "text": "中为了各种科学研究课题的需要，人们常使用形式多样的特殊光源，如各种", "confidence": 0.998454567157861}, {"box": [[227.24185180664062, 606.024169921875], [1269.7010498046875, 613.1900024414062], [1269.7010498046875, 642.8770141601562], [227.24185180664062, 635.711181640625]], "text": "电弧和气体辉光放电管等。1960年发明的激光器，则是一种与所有过去的", "confidence": 0.9987656141028685}, {"box": [[227.24185180664062, 654.1375732421875], [1268.68212890625, 661.3034057617188], [1268.68212890625, 690.9904174804688], [227.24185180664062, 683.8245849609375]], "text": "光源性质不同的崭新光源。光既然是一种电磁辐射，就要有某种能量的补给", "confidence": 0.9972745451060209}, {"box": [[226.2228240966797, 702.2509765625], [1255.434814453125, 709.4168090820312], [1255.434814453125, 739.1038208007812], [226.2228240966797, 731.93798828125]], "text": "来维持其发射，按能量补给的方式不同，光的发射大致可分为以下两大类。", "confidence": 0.996912237369653}, {"box": [[290.42120361328125, 750.3643798828125], [453.4646911621094, 749.3406982421875], [453.4646911621094, 784.1461791992188], [290.42120361328125, 785.1698608398438]], "text": "（1）热辐射", "confidence": 0.9992817441622416}, {"box": [[290.42120361328125, 799.5015258789062], [1268.68212890625, 807.6910400390625], [1268.68212890625, 837.3779907226562], [290.42120361328125, 829.1884765625]], "text": "不断给物体加热来维持一定的温度，物体就会持续地发射光，包括红外", "confidence": 0.9967703396274198}, {"box": [[224.18478393554688, 847.6149291992188], [1268.68212890625, 854.78076171875], [1268.68212890625, 885.491455078125], [224.18478393554688, 878.3256225585938]], "text": "线、紫外线等不可见的光。在一定温度下处于热平衡状态下物体的辐射，叫", "confidence": 0.9965364571773645}, {"box": [[225.2038116455078, 896.7520141601562], [1025.1358642578125, 902.8941650390625], [1025.1358642578125, 932.5811157226562], [225.2038116455078, 926.4390258789062]], "text": "做热辐射或温度辐射。太阳、白炽灯中光的发射属于此类。", "confidence": 0.9974855551352868}, {"box": [[289.4021911621094, 944.8654174804688], [548.2337036132812, 946.9127807617188], [548.2337036132812, 977.6234741210938], [289.4021911621094, 975.5761108398438]], "text": "（2）光的非热发射", "confidence": 0.997249616516961}, {"box": [[289.4021911621094, 991.9551391601562], [1265.625, 1001.1683349609375], [1265.625, 1031.8790283203125], [289.4021911621094, 1022.6658325195312]], "text": "各种气体放电管（如日光灯、水银灯）管内的发光过程是靠电场来补给", "confidence": 0.9947384422825228}, {"box": [[224.18478393554688, 1040.0684814453125], [1267.6630859375, 1048.258056640625], [1267.6630859375, 1078.96875], [224.18478393554688, 1070.7791748046875]], "text": "能量的，这过程叫做电致发光。某些物质在放射线、X射线、紫外线、可见光", "confidence": 0.9901280052521649}, {"box": [[223.16575622558594, 1088.1820068359375], [1267.6630859375, 1096.3714599609375], [1267.6630859375, 1127.0821533203125], [223.16575622558594, 1118.892578125]], "text": "或电子束的照射或轰击下，可以发出可见光来。这一种过程叫做荧光。日光", "confidence": 0.9972263032739813}, {"box": [[222.14674377441406, 1137.319091796875], [1265.625, 1146.5322265625], [1265.625, 1177.242919921875], [222.14674377441406, 1168.02978515625]], "text": "灯管壁上的荧光物质、示波管或电视显像管中的荧光屏的发光属于此类。有", "confidence": 0.9969353748090339}, {"box": [[222.14674377441406, 1185.4324951171875], [1266.64404296875, 1194.6456298828125], [1266.64404296875, 1225.3563232421875], [222.14674377441406, 1216.1431884765625]], "text": "的物质在上述各种射线的辐照之后，可以在一段时间内持续发光，这种过程", "confidence": 0.9971336884932085}, {"box": [[222.14674377441406, 1233.5458984375], [1265.625, 1243.78271484375], [1265.625, 1274.493408203125], [222.14674377441406, 1264.256591796875]], "text": "叫做磷光，夜光表上的磷光物质的发光属于此类。由于化学反应而发光的过", "confidence": 0.9965333902474606}, {"box": [[222.14674377441406, 1281.6593017578125], [1264.60595703125, 1290.8724365234375], [1264.60595703125, 1321.5831298828125], [222.14674377441406, 1312.3699951171875]], "text": "程，叫做化学发光，腐物中的磷在空气中缓慢氧化发出的光（如有时在坟地", "confidence": 0.9937877673091311}, {"box": [[221.1277160644