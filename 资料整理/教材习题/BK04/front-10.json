8], [869.2255249023438, 577.8629150390625], [837.6358642578125, 577.8629150390625]], "text": "10\"5", "confidence": 0.6570523828268051}, {"box": [[943.6141357421875, 557.2984008789062], [994.5652465820312, 557.2984008789062], [994.5652465820312, 579.9193115234375], [943.6141357421875, 579.9193115234375]], "text": "的距高", "confidence": 0.9905076821645101}, {"box": [[495.24456787109375, 600.4838256835938], [545.1766357421875, 598.4274291992188], [546.1956787109375, 620.0201416015625], [496.2635803222656, 622.0765991210938]], "text": "最小的", "confidence": 0.9979084730148315}, {"box": [[920.1766357421875, 612.8225708007812], [966.0325927734375, 612.8225708007812], [966.0325927734375, 631.3306274414062], [920.1766357421875, 631.3306274414062]], "text": "太阳系", "confidence": 0.987346887588501}, {"box": [[521.7391357421875, 677.6007690429688], [590.0136108398438, 677.6007690429688], [590.0136108398438, 695.0806274414062], [521.7391357421875, 695.0806274414062]], "text": "DNA长度", "confidence": 0.9947233080863953}, {"box": [[636.8886108398438, 724.899169921875], [714.334228515625, 724.899169921875], [714.334228515625, 746.491943359375], [636.8886108398438, 746.491943359375]], "text": "人类", "confidence": 0.898398756980896}, {"box": [[737.771728515625, 733.125], [757.1331787109375, 733.125], [757.1331787109375, 752.6612548828125], [737.771728515625, 752.6612548828125]], "text": "山", "confidence": 0.999715268611908}, {"box": [[258.8315124511719, 797.9031982421875], [1270.7200927734375, 798.9314575195312], [1270.7200927734375, 823.6088256835938], [258.8315124511719, 822.5806274414062]], "text": "物理学是探讨物质基本结构和运动基本规律的学科。从研究对象的空间尺度来看，大小至少跨", "confidence": 0.9979908320961929}, {"box": [[206.86141967773438, 838.0040283203125], [413.72283935546875, 840.0604858398438], [413.72283935546875, 866.7943115234375], [206.86141967773438, 864.7378540039062]], "text": "越了42个数量级。", "confidence": 0.9991907344924079}, {"box": [[256.7934875488281, 881.1895141601562], [1271.7391357421875, 883.2459716796875], [1271.7391357421875, 909.9797973632812], [256.7934875488281, 907.92333984375]], "text": "人类是认识自然界的主体，我们以自身的大小为尺度规定了长度的基本单位一米（meter）。", "confidence": 0.9878042381863261}, {"box": [[209.91848754882812, 923.3467407226562], [1269.7010498046875, 926.4314575195312], [1269.7010498046875, 950.0806274414062], [209.91848754882812, 946.9959716796875]], "text": "与此尺度相当的研究对象为宏观物体，以伽利略为标志，物理学的研究是从这个层次上开始的，即", "confidence": 0.9940651073012241}, {"box": [[205.84239196777344, 961.39111328125], [1271.7391357421875, 963.4475708007812], [1271.7391357421875, 994.2943115234375], [205.84239196777344, 992.2378540039062]], "text": "所谓宏观物理学。19-20世纪之交物理学家开始深入到物质的分子、原子层次（10-~10-10m），在这", "confidence": 0.9641884676381653}, {"box": [[207.88043212890625, 1006.633056640625], [1269.7010498046875, 1010.7459716796875], [1269.7010498046875, 1034.3951416015625], [207.88043212890625, 1030.2822265625]], "text": "个尺度上物质运动服从的规律与宏观物体有本质的区别，物理学家把分子、原子，以及后来发现更", "confidence": 0.9978359244590582}, {"box": [[206.86141967773438, 1048.790283203125], [1269.7010498046875, 1051.875], [1269.7010498046875, 1076.5523681640625], [206.86141967773438, 1073.4677734375]], "text": "深层次的物质客体（各种粒子，如原子核、质子、中子、电子、中微子、夸克）称为微观物体。微观物理", "confidence": 0.9869171769722648}, {"box": [[205.84239196777344, 1132.0765380859375], [977.2418823242188, 1135.1612548828125], [977.2418823242188, 1158.8104248046875], [205.84239196777344, 1155.725830078125]], "text": "这学科里的辉煌成就，是60年代以来逐步形成了粒子物理的标准模型。", "confidence": 0.9923681616783142}, {"box": [[254.75543212890625, 1172.1773681640625], [1269.7010498046875, 1176.290283203125], [1269.7010498046875, 1203.024169921875], [254.75543212890625, 1198.9112548828125]], "text": "近年来，由于材料科学的进步，在介于宏观和微观的尺度之间发展出研究宏观量子现象的一门", "confidence": 0.996408273534077}, {"box": [[205.84239196777344, 1213.306396484375], [1268.68212890625, 1217.4193115234375], [1268.68212890625, 1245.181396484375], [205.84239196777344, 1241.0684814453125]], "text": "新兴的学科一介观物理学。此外，生命的物质基础是生物大分子，如蛋白质、DNA，其中包含的原", "confidence": 0.9911916120485826}, {"box": [[204.8233642578125, 1252.3790283203125], [1270.7200927734375, 1258.54833984375], [1270.7200927734375, 1289.3951416015625], [204.8233642578125, 1283.225830078125]], "text": "子数达10*-10\"之多，如果把继绕盘旋的分子链拉直，长度可达10→m的数量级。细胞是生命的基本", "confidence": 0.9442979159454504}, {"box": [[204.8233642578125, 1293.508056640625], [1268.68212890625, 1297.6209716796875], [1268.68212890625, 1328.4676513671875], [204.8233642578125, 1324.3548583984375]], "text": "单位,直径一般在10-~10-6m之间，最小的也至少有10-7m的数量级。从物理学的角度看，这是目", "confidence": 0.954789297921317}, {"box": [[204.8233642578125, 1337.7216796875], [763.247314453125, 1341.8345947265625], [763.247314453125, 1368.5684814453125], [204.8233642578125, 1364.45556640625]], "text": "前最活跃的交叉学科-一生物物理学的研究领域。", "confidence": 0.9671574248508974}, {"box": [[254.75543212890625, 1380.9072265625], [1267.6630859375, 1380.9072265625], [1267.6630859375, 1411.7540283203125], [254.75543212890625, 1411.7540283203125]], "text": "现在把目光转向大尺度。离我们最近的研究对象是山川地体、大气海洋，尺度的数量级在103~", "confidence": 0.9823984309684398}, {"box": [[192.59510803222656, 1416.8951416015625], [1269.7010498046875, 1424.0926513671875], [1269.7010498046875, 1454.939453125], [192.59510803222656, 1447.741943359375]], "text": "107m范围内，从物理学的角度看，属地球物理学的领域。扩大到日月星辰，属天文学和天体物理学的", "confidence": 0.978214293718338}, {"box": [[203.80435180664062, 1462.1370849609375], [1268.68212890625, 1467.2781982421875], [1268.68212890625, 1494.0120849609375], [203.80435180664062, 1488.8709716796875]], "text": "的范围，从个别天体到太阳系、银河系，从星系团到超星系团，尺度横跨了十几个数量级。物理学最", "confidence": 0.9866859357465397}, {"box": [[201.7663116455078, 1501.2095947265625], [1268.68212890625, 1507.3790283203125], [1268.68212890625, 1537.197509765625], [201.7663116455078, 1531.0281982421875]], "text": "大的研究对象是整个宇宙，最远观察极限是哈勃半径，尺度达1026~1027m的数量级。字宙学实际上", "confidence": 0.9804504414399465}, {"box": [[202.7853240966797, 1546.4515380859375], [1266.64404296875, 1552.6209716796875], [1266.64404296875, 1577.29833984375], [202.7853240966797, 1571.1290283203125]], "text": "是物理学的一个分支，当代宇宙学的前沿课题是宇宙的起源和演化，20世纪后半叶这方面的巨大", "confidence": 0.9787947466207105}, {"box": [[201.7663116455078, 1586.5523681640625], [1269.7010498046875, 1592.7216796875], [1269.7010498046875, 1619.45556640625], [201.7663116455078, 1613.2862548828125]], "text": "成就是建立了大爆炸标准宇宙模型。这模型宣称，宇宙是在一百多亿年前的一次大爆炸中诞生的，", "confidence": 0.9950454373692357}, {"box": [[202.7853240966797, 1628.7095947265625], [1266.64404296875, 1635.9072265625], [1266.64404296875, 1660.5845947265625], [202.7853240966797, 1653.3870849609375]], "text": "开初物质的密度和温度都极高，那时既没有原子和分子，更谈不到恒星与星系，有的只是极高温的", "confidence": 0.996575512165247}, {"box": [[201.7663116455078, 1669.838623046875], [1267.6630859375, 1676.008056640625], [1267.6630859375, 1702.741943359375], [201.7663116455078, 1696.572509765625]], "text": "热辐射和在其中隐现的高能粒子。于是，早期的宇宙成了粒子物理学研究的对象。粒子物理学的主", "confidence": 0.9927423859751502}, {"box": [[200.74728393554688, 1711.9959716796875], [1266.64404296875, 1719.1934814453125], [1266.64404296875, 1742.8426513671875], [200.74728393554688, 1735.6451416015625]], "text": "要实验手段是加速器，但加速器能量的提高受到财力、物力和社会等因素的限制。粒子物理学家也", "confidence": 0.9974192810613055}, {"box": [[199.72825622558594, 1751.0684814453125], [1267.6630859375, 1758.26611328125], [1267.6630859375, 1785.0], [199.72825622558594, 1777.8023681640625]], "text": "希望从宇宙早期演化的观测中获得一些信息和证据来检验极高能量下的粒子理论。就这样，物理", "confidence": 0.9962854640824454}, {"box": [[200.74728393554688, 1792.197509765625], [1267.6630859375, 1800.42333984375], [1267.6630859375, 1827.1572265625], [200.74728393554688, 1818.931396484375]], "text": "学中研究最大对象和最小对象的两个分支一一宇宙学和粒子物理学，竟奇妙地衔接在一起，结成", "confidence": 0.9822378385634649}, {"box": [[199.72825622558594, 1834.354736328125], [817.2554321289062, 1839.4959716796875], [817.2554321289062, 1866.229736328125], [199.72825622558594, 1861.088623046875]], "text": "为密不可分的姊妹学科，犹如一条怪鳞咬住自已的尾巴。", "confidence": 0.9641546988487244}]