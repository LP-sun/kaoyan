[{"box": [[716.372314453125, 205.64515686035156], [771.3994750976562, 205.64515686035156], [771.3994750976562, 253.97177124023438], [716.372314453125, 253.97177124023438]], "text": "序", "confidence": 0.9937496185302734}, {"box": [[275.1358642578125, 331.0887145996094], [1275.815185546875, 330.06048583984375], [1275.815185546875, 363.9919128417969], [275.1358642578125, 365.0201416015625]], "text": "1991年10月在上海召开的普通物理教材建设组会议上，与会者一致", "confidence": 0.9996079057455063}, {"box": [[211.95652770996094, 381.4717712402344], [1273.7772216796875, 381.4717712402344], [1273.7772216796875, 412.31854248046875], [211.95652770996094, 412.31854248046875]], "text": "认为，努力反映物理学当代成就，使基础课的教学内容更好地适应物理学发", "confidence": 0.9985780607570302}, {"box": [[210.9375, 430.82659912109375], [1273.7772216796875, 429.7983703613281], [1273.7772216796875, 460.6451416015625], [210.9375, 461.6733703613281]], "text": "展的需要，是当前普物教材建设中的一个重要课题。编写这样一套教材的", "confidence": 0.9962231516838074}, {"box": [[208.8994598388672, 479.1531982421875], [775.4755249023438, 480.1814270019531], [775.4755249023438, 511.0281982421875], [208.8994598388672, 510.0]], "text": "设想，就是在那次会议上初步定下来的。", "confidence": 0.9991118643018935}, {"box": [[276.1549072265625, 527.4797973632812], [1269.7010498046875, 529.5362548828125], [1269.7010498046875, 560.383056640625], [276.1549072265625, 558.3265991210938]], "text": "从牛顿到爱因斯坦，标志着从经典物理到近代物理的转变，大约用了", "confidence": 0.9976332247257232}, {"box": [[205.84239196777344, 574.7781982421875], [1274.7962646484375, 577.8629150390625], [1274.7962646484375, 611.7943115234375], [205.84239196777344, 608.7096557617188]], "text": "300年，知识更新的时间尺度以百年计。本世纪以来，科学技术的进步是加", "confidence": 0.992190560873817}, {"box": [[207.88043212890625, 625.1612548828125], [1273.7772216796875, 627.2177124023438], [1273.7772216796875, 658.0645141601562], [207.88043212890625, 656.008056640625]], "text": "速发展的。如果说上半个世纪发展的时间常数还有三四十年，则下半个世", "confidence": 0.9994573965668678}, {"box": [[207.88043212890625, 672.4596557617188], [1274.7962646484375, 675.5443115234375], [1274.7962646484375, 709.4757690429688], [207.88043212890625, 706.39111328125]], "text": "纪已缩短到一二十年。在一个人的一生中，就会不断受到科学知识和科学", "confidence": 0.9960717968642712}, {"box": [[208.8994598388672, 723.8709716796875], [1272.7581787109375, 725.9274291992188], [1272.7581787109375, 756.774169921875], [208.8994598388672, 754.7177124023438]], "text": "观念老化的威胁。我们这代人对此是有亲身体会的。当前正处于世纪之", "confidence": 0.9987212938647116}, {"box": [[208.8994598388672, 772.1975708007812], [1271.7391357421875, 775.2822265625], [1271.7391357421875, 806.1290283203125], [208.8994598388672, 803.0443115234375]], "text": "交，培养的下一代学生将成为21世纪的骨干。如何使他们在走出校门之后", "confidence": 0.9923116564750671}, {"box": [[208.8994598388672, 820.524169921875], [1275.815185546875, 824.6370849609375], [1275.815185546875, 855.4838256835938], [208.8994598388672, 851.3709716796875]], "text": "能适应比现在更加迅猛发展的科学技术，是我们教师现在必须考虑的问题，", "confidence": 0.9964474656365134}, {"box": [[206.86141967773438, 869.8790283203125], [957.8804321289062, 872.9636840820312], [957.8804321289062, 903.8104858398438], [206.86141967773438, 900.7257690429688]], "text": "编写适应此形势的新教材是其中的一个重要的方面。", "confidence": 0.9989761658336805}, {"box": [[273.09783935546875, 919.2338256835938], [1271.7391357421875, 923.3467407226562], [1271.7391357421875, 954.1935424804688], [273.09783935546875, 950.0806274414062]], "text": "普物力学是基础课的基础，多年来总给人以老面孔的感觉。学生抱怨", "confidence": 0.9991018811861674}, {"box": [[207.88043212890625, 966.5322265625], [1272.7581787109375, 971.67333984375], [1272.7581787109375, 1005.6047973632812], [207.88043212890625, 1000.4636840820312]], "text": "与中学重复，把理论力学的一套搬下来，也不是办法。我们深感普物力学教", "confidence": 0.9984285361839064}, {"box": [[206.86141967773438, 1016.915283203125], [1271.7391357421875, 1022.056396484375], [1271.7391357421875, 1052.9031982421875], [206.86141967773438, 1047.7620849609375]], "text": "材的改造任务特别追切。为此，我们从1992年开始着手编写这本教材，并", "confidence": 0.995524625567829}, {"box": [[207.88043212890625, 1066.2701416015625], [1272.7581787109375, 1071.4112548828125], [1272.7581787109375, 1102.258056640625], [207.88043212890625, 1097.116943359375]], "text": "于1993年和1994年连续两年分别在北京大学和中山大学物理类专业试", "confidence": 0.9993604071000043}, {"box": [[207.88043212890625, 1115.625], [1271.7391357421875, 1119.7379150390625], [1271.7391357421875, 1150.5845947265625], [207.88043212890625, 1146.4718017578125]], "text": "用。在通过各种方式征求同行专家意见的基础上进行了两次修订。本教材", "confidence": 0.9992704391479492}, {"box": [[205.84239196777344, 1163.9515380859375], [774.45654296875, 1168.064453125], [774.45654296875, 1198.9112548828125], [205.84239196777344, 1194.79833984375]], "text": "编写的指导思想，概要来说有以下几点：", "confidence": 0.9986932741271125}, {"box": [[205.84239196777344, 1221.5322265625], [992.5271606445312, 1224.616943359375], [992.5271606445312, 1257.5201416015625], [205.84239196777344, 1254.4354248046875]], "text": "一、用现代的观点审视、选择和组织好传统的教学内容", "confidence": 0.9963368251919746}, {"box": [[269.021728515625, 1279.1129150390625], [1270.7200927734375, 1285.2822265625], [1270.7200927734375, 1318.1854248046875], [269.021728515625, 1312.01611328125]], "text": "上面我们笼统地谈到知识和观念老化的时间尺度问题，实际上两者更", "confidence": 0.9968139390150706}, {"box": [[203.80435180664062, 1326.4112548828125], [1270.7200927734375, 1333.60888671875], [1270.7200927734375, 1366.5120849609375], [203.80435180664062, 1359.314453125]], "text": "新的速度是不一样的。现代高技术的发展突飞猛进，计算机产品差不多每", "confidence": 0.9967540074139833}, {"box": [[204.8233642578125, 1376.7943115234375], [1270.7200927734375, 1383.991943359375], [1270.7200927734375, 1416.8951416015625], [204.8233642578125, 1409.697509765625]], "text": "半年就可能换一代。物理学里知识的更新也比较快,几年不接触，文献里的", "confidence": 0.9755347389163394}, {"box": [[203.80435180664062, 1425.1209716796875], [1271.7391357421875, 1431.290283203125], [1271.7391357421875, 1465.2216796875], [203.80435180664062, 1459.0523681640625]], "text": "名词就看不懂了。但是基础科学里基本概念的更新，节奏要缓慢得多，不过", "confidence": 0.9939618327400901}, {"box": [[204.8233642578125, 1476.5322265625], [1269.7010498046875, 1483.7298583984375], [1269.7010498046875, 1514.5765380859375], [204.8233642578125, 1507.3790283203125]], "text": "其影响也深远得多。作为基础物理学教材，本书在知识更新和概念更新两", "confidence": 0.998948723077774}, {"box": [[204.8233642578125, 1525.8870849609375], [1227.9212646484375, 1533.0845947265625], [1227.9212646484375, 1563.931396484375], [204.8233642578125, 1556.73388671875]], "text": "个方面，更侧重于后者。可以认为，这是本书取名“新概念”寓意之所在。", "confidence": 0.9986071207306602}, {"box": [[270.040771484375, 1575.241943359375], [1267.6630859375, 1582.439453125], [1267.6630859375, 1613.2862548828125], [270.040771484375, 1606.088623046875]], "text": "普通物理的力学是以经典内容为主的，它们现在仍是学习物理学的重", "confidence": 0.9993726273377737}, {"box": [[201.7663116455078, 1621.5120849609375], [1268.68212890625, 1630.76611328125], [1268.68212890625, 1664.697509765625], [201.7663116455078, 1655.4434814453125]], "text": "要基础。不过我们要用现代的观点来审视各经典物理基本概念的提法是否", "confidence": 0.9996524155139923}, {"box": [[201.7663116455078, 1671.8951416015625], [1267.6630859375, 1680.1209716796875], [1267.6630859375, 1713.024169921875], [201.7663116455078, 1704.79833984375]], "text": "需要修正，各经典物理定律的相对位置是否发生了变化，等等。据此，我们", "confidence": 0.9885843215566693}, {"box": [[202.7853240966797, 1720.2216796875], [1218.75, 1729.4757080078125], [1218.75, 1762.3790283203125], [202.7853240966797, 1753.125]], "text": "从新的角度重新考虑了教材的体系和对原有内容做了一定的增删取舍。", "confidence": 0.9975722816682631}, {"box": [[266.98370361328125, 1771.633056640625], [1265.625, 1779.8587646484375], [1265.625, 1810.70556640625], [266.98370361328125, 1802.479736328125]], "text": "传统力学教材是以牛顿运动三定律为核心来展开的，并把质量和力作", "confidence": 0.9988820056120554}, {"box": [[201.7663116455078, 1818.931396484375], [1267.6630859375, 1829.213623046875], [1267.6630859375, 1862.116943359375], [201.7663116455078, 1851.8345947265625]], "text": "为动力学中最基本的概念，从而导出动量和能量的概念以及有关的守恒定", "confidence": 0.9993116892874241}]