[{"box": [[237.43206787109375, 101.79434967041016], [272.07879638671875, 101.79434967041016], [272.07879638671875, 138.81048583984375], [237.43206787109375, 138.81048583984375]], "text": "IV", "confidence": 0.9191745221614838}, {"box": [[742.8668823242188, 101.79434967041016], [780.5706787109375, 101.79434967041016], [780.5706787109375, 136.7540283203125], [742.8668823242188, 136.7540283203125]], "text": "序", "confidence": 0.9981511235237122}, {"box": [[229.27989196777344, 188.16531372070312], [1291.1005859375, 188.16531372070312], [1291.1005859375, 217.98387145996094], [229.27989196777344, 217.98387145996094]], "text": "要的“接口”，交代一下可由此延伸出去的领域和课题。即使对这些领域和", "confidence": 0.9986278559222366}, {"box": [[228.2608642578125, 237.52015686035156], [1290.08154296875, 237.52015686035156], [1290.08154296875, 267.3387145996094], [228.2608642578125, 267.3387145996094]], "text": "课题本身并不作过多的介绍，对学生也是大有神益的。例如对于振动，我们", "confidence": 0.9943014690370271}, {"box": [[228.2608642578125, 285.8467712402344], [1289.0625, 285.8467712402344], [1289.0625, 315.6653137207031], [228.2608642578125, 315.6653137207031]], "text": "比传统教材增加了简正模的概念；对于波动，我们用一维弹簧振子链代替传", "confidence": 0.9965002301967505}, {"box": [[227.24185180664062, 334.1733703613281], [1289.0625, 335.20159912109375], [1289.0625, 366.0483703613281], [227.24185180664062, 365.0201416015625]], "text": "统的弦，等等，为固体物理中声子、能带等概念作了铺垫。通常在普通物理", "confidence": 0.9981149435043335}, {"box": [[227.24185180664062, 381.4717712402344], [1289.0625, 384.5564270019531], [1289.0625, 414.375], [227.24185180664062, 411.2903137207031]], "text": "的力学部分讲碰撞时，多以宏观物体为背景，这时弹性与非弹性碰撞的分野", "confidence": 0.9993256529172262}, {"box": [[225.2038116455078, 430.82659912109375], [1289.0625, 433.9112854003906], [1289.0625, 464.758056640625], [225.2038116455078, 461.6733703613281]], "text": "在于有无能量耗散。本教材中指出，对于微观客体之间的碰撞，概念将有所", "confidence": 0.998206042882168}, {"box": [[225.2038116455078, 478.125], [1288.04345703125, 481.20965576171875], [1288.04345703125, 512.0564575195312], [225.2038116455078, 508.9717712402344]], "text": "发展，弹性与非弹性碰撞的分野是指能量有无向内部自由度转移。此外，我", "confidence": 0.9977658445184882}, {"box": [[224.18478393554688, 527.4797973632812], [1288.04345703125, 531.5927124023438], [1288.04345703125, 562.4395141601562], [224.18478393554688, 558.3265991210938]], "text": "们讲碰撞时还适当提及微观领域所关心的角分布问题与相应的散射截面概", "confidence": 0.9987701289355755}, {"box": [[222.14674377441406, 572.7217407226562], [319.97283935546875, 578.89111328125], [317.9347839355469, 615.9072265625], [220.10870361328125, 609.7379150390625]], "text": "念。", "confidence": 0.9993768632411957}, {"box": [[288.3831481933594, 626.1895141601562], [1282.9483642578125, 630.3024291992188], [1282.9483642578125, 660.1209716796875], [288.3831481933594, 656.008056640625]], "text": "在牛顿力学建立之后300年，除相对论、量子力学外，其世界观受到了", "confidence": 0.9988105557858944}, {"box": [[224.18478393554688, 674.51611328125], [1287.0244140625, 679.6572265625], [1287.0244140625, 710.5040283203125], [224.18478393554688, 705.3629150390625]], "text": "来自内部的巨大冲击，那就是混沌运动问题。混沌理论是当前经典物理学", "confidence": 0.9963752124458551}, {"box": [[224.18478393554688, 723.8709716796875], [1286.0054931640625, 729.0120849609375], [1286.0054931640625, 759.8588256835938], [224.18478393554688, 754.7177124023438]], "text": "范围内的前沿课题，当代的经典力学教材不应对此保持默。但是混沌的", "confidence": 0.9983955333309789}, {"box": [[223.16575622558594, 772.1975708007812], [1284.9864501953125, 778.366943359375], [1284.9864501953125, 809.2136840820312], [223.16575622558594, 803.0443115234375]], "text": "理论过于深奥，难以纳入本门课程，而配以适当的接口，并稍为提及混沌的", "confidence": 0.9981701319867914}, {"box": [[223.16575622558594, 821.5523681640625], [1286.0054931640625, 826.6935424804688], [1286.0054931640625, 857.540283203125], [223.16575622558594, 852.399169921875]], "text": "概念本身，是必要而且可能的。非线性振动是通向混沌的重要道路，而现行", "confidence": 0.9984797654729901}, {"box": [[223.16575622558594, 869.8790283203125], [1284.9864501953125, 877.0765991210938], [1284.9864501953125, 907.92333984375], [223.16575622558594, 900.72576904296