[{"box": [[354.0, 182.0], [798.0, 182.0], [798.0, 218.0], [354.0, 218.0]], "text": "第一章静电场恒定电流场", "confidence": 0.9986792423508384}, {"box": [[345.0, 258.0], [811.0, 258.0], [811.0, 288.0], [345.0, 288.0]], "text": "81．静电的基本现象和基本规律", "confidence": 0.9654411514600117}, {"box": [[177.0, 332.0], [321.0, 332.0], [321.0, 355.0], [177.0, 355.0]], "text": "1.1两种电荷", "confidence": 0.9996138725961957}, {"box": [[227.0, 369.0], [974.0, 372.0], [974.0, 398.0], [227.0, 395.0]], "text": "在很早的时候，人们就发现了用毛皮摩擦过的琥珀能够吸引羽毛、头发", "confidence": 0.9989407370167394}, {"box": [[178.0, 404.0], [973.0, 407.0], [973.0, 433.0], [178.0, 430.0]], "text": "等轻小物体。后来发现，摩擦后能吸引轻小物体的现象，并不是琥珀所独有", "confidence": 0.998436916958202}, {"box": [[177.0, 439.0], [975.0, 443.0], [975.0, 468.0], [177.0, 464.0]], "text": "的，像玻璃棒、火漆棒、硬橡胶棒、硫磺块或水晶块等，用毛皮或丝绸摩擦后，", "confidence": 0.9964338115283421}, {"box": [[177.0, 472.0], [532.0, 474.0], [532.0, 501.0], [177.0, 499.0]], "text": "也都能吸引轻小物体(图1－1)。", "confidence": 0.9674059599637985}, {"box": [[235.0, 507.0], [704.0, 509.0], [704.0, 535.0], [235.0, 533.0]], "text": "物体有了这种吸引轻小物体的性质，就说它", "confidence": 0.9980171228709974}, {"box": [[176.0, 541.0], [641.0, 543.0], [641.0, 569.0], [176.0, 567.0]], "text": "带了电，或有了电荷。带电的物体叫带电体。", "confidence": 0.998899731040001}, {"box": [[227.0, 574.0], [705.0, 577.0], [705.0, 603.0], [227.0, 600.0]], "text": "使物体带电叫做起电。用摩擦方法使物体带", "confidence": 0.9997882278341996}, {"box": [[177.0, 610.0], [366.0, 610.0], [366.0, 636.0], [177.0, 636.0]], "text": "电叫做摩擦起电。", "confidence": 0.9993772655725479}, {"box": [[227.0, 643.0], [706.0, 645.0], [706.0, 670.0], [227.0, 668.0]], "text": "实验指出，两根用毛皮摩擦过的硬橡胶棒互", "confidence": 0.9980115545423407}, {"box": [[178.0, 677.0], [706.0, 679.0], [706.0, 705.0], [178.0, 703.0]], "text": "相排斥；两根用绸子摩擦过的玻璃棒也互相排斥；", "confidence": 0.9824897213415666}, {"box": [[178.0, 711.0], [705.0, 714.0], [705.0, 740.0], [178.0, 737.0]], "text": "可是，用毛皮摩擦过的硬橡胶棒与用绸子摩擦过", "confidence": 0.9977848047301883}, {"box": [[177.0, 746.0], [705.0, 748.0], [705.0, 773.0], [177.0, 771.0]], "text": "的玻璃棒互相吸引，这表明硬橡胶棒上的电荷和", "confidence": 0.9953638002985999}, {"box": [[176.0, 779.0], [704.0, 782.0], [704.0, 808.0], [176.0, 805.0]], "text": "玻璃棒上的电荷是不同的。实验证明，所有其它物", "confidence": 0.9983263151212172}, {"box": [[757.0, 800.0], [923.0, 803.0], [922.0, 826.0], [756.0, 823.0]], "text": "图1-1摩擦起电", "confidence": 0.9951167404651642}, {"box": [[177.0, 814.0], [703.0, 817.0], [703.0, 843.0], [177.0, 840.0]], "text": "体，尤论用什么方法起电，所带的电荷或者与玻璃", "confidence": 0.9756229384378954}, {"box": [[175.0, 848.0], [973.0, 852.0], [973.0, 878.0], [175.0, 874.0]], "text": "棒上的电荷相同，或者与硬橡胶棒上的电荷相同。所以，自然界中只存在两", "confidence": 0.9939266045888265}, {"box": [[176.0, 882.0], [750.0, 885.0], [750.0, 911.0], [176.0, 908.0]], "text": "种电荷；而且，同种电荷互相排斥，异种电荷互相吸引。", "confidence": 0.99469562292099}, {"box": [[234.0, 916.0], [674.0, 919.0], [674.0, 945.0], [234.0, 942.0]], "text": "物体所带电荷数量的多少，叫做电荷量，", "confidence": 0.9978183706601461}, {"box": [[176.0, 951.0], [670.0, 954.0], [670.0, 979.0], [176.0, 976.0]], "text": "简称电量。测量电量的最简单的仪器是验电", "confidence": 0.9998062660819605}, {"box": [[177.0, 984.0], [670.0, 987.0], [670.0, 1013.0], [177.0, 1010.0]], "text": "器，其构造如图1-2a所示，在玻璃瓶上装一橡", "confidence": 0.9741627194664695}, {"box": [[175.0, 1019.0], [670.0, 1022.0], [670.0, 1048.0], [175.0, 1045.0]], "text": "胶塞，塞中插一根金属杆，杆的上端有一金属", "confidence": 0.9939917713403702}, {"box": [[174.0, 1053.0], [669.0, 1056.0], [669.0, 1081.0], [174.0, 1078.0]], "text": "球，下端有一对悬挂的金箔（或铝箔）。当带电", "confidence": 0.9919090356145587}, {"box": [[175.0, 1086.0], [669.0, 1090.0], [669.0, 1116.0], [175.0, 1112.0]], "text": "体和金属杆上端的小球接触时，就有一部分电", "confidence": 0.9955925524234772}, {"box": [[176.0, 1121.0], [670.0, 1125.0], [670.0, 1151.0], [176.0, 1147.0]], "text": "荷传到金属杆下端的两块金箔上，它们就因带", "confidence": 0.9966797441244125}, {"box": [[175.0, 1156.0], [671.0, 1160.0], [671.0, 1185.0], [175.0, 1181.0]], "text": "同种电荷互相排斥而张开，所带的电荷愈多，", "confidence": 0.9937832593917847}, {"box": [[174.0, 1190.0], 