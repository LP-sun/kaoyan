[{"box": [[421.0, 98.0], [721.0, 98.0], [721.0, 118.0], [421.0, 118.0]], "text": "1.静电的基本现象和基本规律", "confidence": 0.995709491627557}, {"box": [[941.0, 97.0], [963.0, 97.0], [963.0, 120.0], [941.0, 120.0]], "text": "3", "confidence": 0.996896505355835}, {"box": [[170.0, 156.0], [968.0, 157.0], [968.0, 183.0], [170.0, 182.0]], "text": "过程是电荷从一个物体（或物体的一部分）转移到另一物体（或同一物体的", "confidence": 0.9974553621176517}, {"box": [[171.0, 194.0], [966.0, 196.0], [966.0, 219.0], [171.0, 217.0]], "text": "另一部分）的过程。摩擦起电时，某种电荷从一物体转移至另一物体，从而", "confidence": 0.998870641896219}, {"box": [[171.0, 231.0], [966.0, 233.0], [966.0, 256.0], [171.0, 253.0]], "text": "使两物体的中和状态都遭到破坏，各显电性。警如在负电荷转移的过程中，", "confidence": 0.9776273487192212}, {"box": [[171.0, 266.0], [966.0, 268.0], [966.0, 292.0], [171.0, 290.0]], "text": "失去它的一方带上正电，获得它的一方带上负电，因此两物体带上等量异号", "confidence": 0.9922237757480505}, {"box": [[171.0, 304.0], [968.0, 306.0], [968.0, 329.0], [171.0, 327.0]], "text": "的电荷。在静电感应的现象里也是一样，把带电体C移近时，金属柱体A和", "confidence": 0.998396817481879}, {"box": [[169.0, 340.0], [967.0, 342.0], [967.0, 367.0], [169.0, 365.0]], "text": "B中与C同号的电荷被排斥，异号电荷被吸引I，于是在A、B之间发生了电荷", "confidence": 0.9826738868440901}, {"box": [[171.0, 377.0], [569.0, 379.0], [569.0, 402.0], [171.0, 400.0]], "text": "的转移，使它们带上等量异号的电荷。", "confidence": 0.9988437505329356}, {"box": [[221.0, 414.0], [967.0, 417.0], [967.0, 440.0], [221.0, 437.0]], "text": "从以上一些事实可以总结出如下的定律：电荷既不能被创造，也不能被", "confidence": 0.9990243565651679}, {"box": [[171.0, 452.0], [967.0, 454.0], [967.0, 476.0], [171.0, 474.0]], "text": "消灭，它们只能从一个物体转移到另一个物体，或者从物体的一部分转移到", "confidence": 0.9925540234103347}, {"box": [[172.0, 487.0], [968.0, 489.0], [968.0, 512.0], [172.0, 510.0]], "text": "另一部分，也就是说，在任何物理过程中，电荷的代数和是守恒的。这个定律", "confidence": 0.9991223268649158}, {"box": [[171.0, 524.0], [966.0, 527.0], [966.0, 550.0], [171.0, 547.0]], "text": "叫做电荷守恒定律。电荷守恒定律不仅在一切宏观过程中成立，近代科学实", "confidence": 0.9988008936246237}, {"box": [[171.0, 560.0], [967.0, 563.0], [967.0, 586.0], [171.0, 583.0]], "text": "践证明，它也是一切微观过程（如核反应和“基本”粒子过程）所普遍遵守", "confidence": 0.9976506522207549}, {"box": [[171.0, 594.0], [612.0, 597.0], [612.0, 624.0], [171.0, 621.0]], "text": "的。它是物理学中普遍的基本定律之一。", "confidence": 0.9990661276711358}, {"box": [[170.0, 640.0], [452.0, 641.0], [452.0, 664.0], [170.0, 663.0]], "text": "1.3导体、绝缘体和半导体", "confidence": 0.9992846388083237}, {"box": [[220.0, 681.0], [966.0, 684.0], [966.0, 708.0], [220.0, 705.0]], "text": "如果使带电体同玻璃棒的某个地方接触，玻璃棒的那个地方就带上电", "confidence": 0.9958427369594574}, {"box": [[172.0, 718.0], [967.0, 721.0], [967.0, 745.0], [172.0, 742.0]], "text": "荷，可是别的地方仍旧不带电。如果使带电体同金属物体的某个地方（例如", "confidence": 0.9988250497615698}, {"box": [[172.0, 754.0], [967.0, 758.0], [967.0, 783.0], [172.0, 779.0]], "text": "验电器中金属秆上端的球）接触，那么，不仅接触的地方带电，而且金属物", "confidence": 0.9964760108427568}, {"box": [[169.0, 829.0], [967.0, 832.0], [967.0, 855.0], [169.0, 852.0]], "text": "B因静电感应而带的电荷并不会沿玻璃支柱跑掉，但是当它们重新接触时，", "confidence": 0.9985813083070697}, {"box": [[171.0, 864.0], [533.0, 865.0], [533.0, 891.0], [171.0, 890.0]], "text": "两边的电荷却能跑到一起而中和。", "confidence": 0.9990546504656473}, {"box": [[221.0, 900.0], [966.0, 903.0], [966.0, 929.0], [221.0, 926.0]], "text": "从许多这类实验中可以得到一个结论，就是按照电荷在其中是否容易", "confidence": 0.999251147111257}, {"box": [[170.0, 938.0], [966.0, 942.0], [966.0, 965.0], [170.0, 960.0]], "text": "转移或传导，习惯上可以把物体大致分成两类：（1）电荷能够从产生的地方", "confidence": 0.9970239067778868}, {"box": [[171.0, 974.0], [966.0, 978.0], [966.0, 1001.0], [171.0, 997.0]], "text": "迅速转移或传导到其它部分的那种物体，叫做导体；（2）电荷几乎只能停留", "confidence": 0.9925932884216309}, {"box": [[171.0, 1011.0], [966.0, 1015.0], [966.0, 1039.0], [171.0, 1035.0]], "text": "在产生的地方的那种物体，叫做绝缘体。金属、石墨、电解液（酸、碱、盐类的", "confidence": 0.9967756032943725}, {"box": [[172.0, 1048.0], [967.0, 1052.0], [967.0, 1075.0], [172.0, 1071.0]], "text": "水溶液）、人体、地、电离了的气体等都是导体；玻璃、橡胶、丝绸、琥珀、松", "confidence": 0.9909964953150068}, {"box": [[170.0, 1085.0], [709.0, 1087.0], [709.0, 1111.0], [170.0, 1109.0]], "text": "香、硫磺、瓷器、油类、未电离的气体等都是绝缘体。", "confidence": 0.998142475883166}, {"box": [[220.0, 1121.0], [966.0, 1125.0], [966.0, 1151.0], [220.0, 1147.0]], "text": "应当指出，这种分类不是绝对的，导体和绝缘体之间并没有严格的界", "confidence": 0.9993144134680431}, {"box": [[171.0, 1159.0], [968.0, 1164.0], [968.0, 1186.0], [171.0, 1181.0]], "text": "限。在一定的条件下物体转移或传导电荷的能力（称为导电能力）将发生变", "confidence": 0.9987628983728813}, {"box": [[212.0, 1242.0], [966.0, 1245.0], [966.0, 1268.0], [212.0, 1265.0]], "text": "●举个突出的例子来说明，高能光子（√射线）和原子核相碰时，会产生一对正负", "confidence": 0.9620931438273854}, {"box": [[169.0, 1271.0], [967.0, 1276.0], [967.0, 1299.0], [169.0, 1294.0]], "text": "电子（电子对的产生）；反之，当一对正负电子互相靠近时会融合而消失，在消失处产生", "confidence": 0.9895627284661318}, {"box": [[167.0, 1302.0], [969.0, 1305.0], [969.0, 1331.0], [167.0, 1328.0]], "text": "辐射（电子对的湮没）。光子不带电，正负电子所带的电荷等量异号，故在此微观过程", "confidence": 0.9770226604060123}, {"box": [[170.0, 1334.0], [967.0, 1338.0], [967.0, 1362.0], [170.0, 1358.0]], "text": "中尽管粒子产生或消灭了，但过程前后电荷的代数总和仍没有变。这便是在微观领域内", "confidence": 0.9978472590446472}, {"box": [[170.0, 1365.0], [514.0, 1369.0], [514.0, 1391.0], [170.0, 1388.0]], "text": "对电荷不被创造、不被消灭的新理解。", "confidence": 0.9994390186141519}]