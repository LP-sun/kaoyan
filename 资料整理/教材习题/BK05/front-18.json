[{"box": [[174.0, 98.0], [194.0, 98.0], [194.0, 121.0], [174.0, 121.0]], "text": "4", "confidence": 0.998687207698822}, {"box": [[439.0, 99.0], [695.0, 99.0], [695.0, 119.0], [439.0, 119.0]], "text": "第一章静电场恒定电流场", "confidence": 0.9989226026968523}, {"box": [[170.0, 159.0], [964.0, 159.0], [964.0, 182.0], [170.0, 182.0]], "text": "化，例如，绝缘体在强电力作用下将被击穿而成为导体。另外，还有许多称为", "confidence": 0.9989070664433872}, {"box": [[169.0, 196.0], [967.0, 195.0], [967.0, 219.0], [169.0, 220.0]], "text": "半导体的物质，它们的导电能力介于导体和绝缘体之间，而且对温度、光照、", "confidence": 0.9977717084043166}, {"box": [[169.0, 233.0], [605.0, 232.0], [605.0, 255.0], [169.0, 256.0]], "text": "杂质、压力、电磁场等外加条件极为敏感。", "confidence": 0.9994410935201143}, {"box": [[167.0, 275.0], [363.0, 275.0], [363.0, 298.0], [167.0, 298.0]], "text": "1.4物质的电结构", "confidence": 0.9993330770068698}, {"box": [[220.0, 318.0], [966.0, 318.0], [966.0, 341.0], [220.0, 341.0]], "text": "近代物理学的发展已使我们对带电现象的本质有了深入的了解。物质", "confidence": 0.9974054157733917}, {"box": [[171.0, 354.0], [966.0, 354.0], [966.0, 376.0], [171.0, 376.0]], "text": "是由分子、原子组成的，而原子又由带正电的原子核和带负电的电子组成，", "confidence": 0.9960100217299028}, {"box": [[170.0, 389.0], [965.0, 389.0], [965.0, 412.0], [170.0, 412.0]], "text": "原子核中有质子和中子，中子不带电，质子带正电。一个质子所带的电量和", "confidence": 0.9993769472295587}, {"box": [[168.0, 424.0], [966.0, 425.0], [966.0, 451.0], [168.0, 450.0]], "text": "一个电子所带的电量数值相等，也就是说，如果用e代表一个质子的电量，", "confidence": 0.9949655568960941}, {"box": [[170.0, 462.0], [460.0, 462.0], [460.0, 485.0], [170.0, 485.0]], "text": "则一个电子的电量就是-e.", "confidence": 0.9708996002490704}, {"box": [[170.0, 536.0], [966.0, 536.0], [966.0, 558.0], [170.0, 558.0]], "text": "过程的内在根据。由于在正常情况下物体中任何一部分所包含的电子的总", "confidence": 0.9989939536899328}, {"box": [[169.0, 569.0], [966.0, 571.0], [966.0, 595.0], [169.0, 593.0]], "text": "数和质子的总数是相等的，所以对外界不表现出电性。但是，如果在一定的", "confidence": 0.9985837358416934}, {"box": [[170.0, 606.0], [964.0, 607.0], [964.0, 631.0], [170.0, 630.0]], "text": "外因作用下，物体（或其中的一部分）得到或失去一定数量的电子，使得电", "confidence": 0.9980521292397471}, {"box": [[172.0, 644.0], [720.0, 644.0], [720.0, 666.0], [172.0, 666.0]], "text": "子的总数和质子的总数不再相等，物体就呈现电性。", "confidence": 0.9989470891330553}, {"box": [[220.0, 678.0], [966.0, 679.0], [966.0, 705.0], [220.0, 704.0]], "text": "两种不同质料的物体互相摩擦后所以都会带电，是因为通过摩擦，每个", "confidence": 0.9989365627688747}, {"box": [[170.0, 715.0], [965.0, 716.0], [965.0, 740.0], [170.0, 739.0]], "text": "物体中都有一些电子脱离了原子的束缚，跑到另一物体上去。但是，不同材", "confidence": 0.9965625929109978}, {"box": [[170.0, 752.0], [965.0, 753.0], [965.0, 776.0], [170.0, 775.0]], "text": "料的物体彼此向对方转移的电子数目往往不相等，所以总体上讲，一个物体", "confidence": 0.9977707465489706}, {"box": [[170.0, 788.0], [966.0, 790.0], [966.0, 813.0], [170.0, 811.0]], "text": "失去了电子，另-个物体得到了电子，结果失去电子的物体就带正电，得到", "confidence": 0.9828998888983871}, {"box": [[170.0, 824.0], [966.0, 826.0], [966.0, 849.0], [170.0, 847.0]], "text": "电子的物体就带负电。因此，摩擦带电实际上就是通过摩擦作用使电子从", "confidence": 0.9985255673527718}, {"box": [[170.0, 859.0], [555.0, 862.0], [555.0, 885.0], [170.0, 883.0]], "text": "一个物体转移到另一个物体的过程。", "confidence": 0.9997465796768665}, {"box": [[220.0, 897.0], [966.0, 899.0], [966.0, 923.0], [220.0, 921.0]], "text": "在金属导体里，原子中的最外层电子（价电子）可以摆脱原子的束缚，", "confidence": 0.9969809843647864}, {"box": [[170.0, 934.0], [965.0, 935.0], [965.0, 959.0], [170.0, 958.0]], "text": "在整个导体中自由运动，这类电子叫做自由电子。原子中除价电子外的其余", "confidence": 0.9985608295960859}, {"box": [[171.0, 970.0], [966.0, 972.0], [966.0, 995.0], [171.0, 993.0]], "text": "部分叫原子实。在固态金属中原子实排列成整齐的点阵，称为晶格或晶体点", "confidence": 0.9991049423362269}, {"box": [[170.0, 1007.0], [967.0, 1009.0], [967.0, 1032.0], [170.0, 1030.0]], "text": "阵。自由电子在晶体点阵间跑来跑去，像气体的分子那样作无规运动，并不", "confidence": 0.9991615938417839}, {"box": [[169.0, 1043.0], [966.0, 1046.0], [966.0, 1068.0], [169.0, 1065.0]], "text": "时地彼此碰撞或与点阵上的原子实碰撞。这就是金属微观结构的经典图像。", "confidence": 0.99865215474909}, {"box": [[169.0, 1078.0], [967.0, 1082.0], [967.0, 1105.0], [169.0, 1101.0]], "text": "图1-3所示的静电感应现象可解释如下，当我们把带正电的物体（图1-3a", "confidence": 0.9891802668571472}, {"box": [[171.0, 1115.0], [966.0, 1118.0], [966.0, 1142.0], [171.0, 1139.0]], "text": "中的C）移到金属导体（图中的A和B）附近时，导体内的自由电子就受到", "confidence": 0.9955175537051577}, {"box": [[170.0, 1153.0], [966.0, 1155.0], [966.0, 1178.0], [170.0, 1176.0]], "text": "正电荷的吸引力，向靠近带电体的一端移动。结果导体的这一端就因电子过", "confidence": 0.9987995841286399}, {"box": [[171.0, 1188.0], [966.0, 1192.0], [966.0, 1215.0], [171.0, 1211.0]], "text": "多而带负电，另一端则因电子过少而带正电。从这里可以看出，感应带电实", "confidence": 0.9982771458047809}, {"box": [[169.0, 1225.0], [965.0, 1229.0], [965.0, 1252.0], [169.0, 1248.0]], "text": "际上是在外界电力的作用下，自由电子由导体的一部分转移到另一部分造", "confidence": 0.9995326213538647}, {"box": [[169.0, 1260.0], [233.0, 1263.0], [232.0, 1288.0], [168.0, 1285.0]], "text": "成的。", "confidence": 0.9999181230862936}, {"box": [[218.0, 1297.0], [964.0, 1300.0], [964.0, 1324.0], [218.0, 1321.0]], "text": "一切导体所以能够导电，是因为它们内部存在着可以自由移动的电荷，", "confidence": 0.9982029737964753}, {"box": [[169.0, 1365.0], [965.0, 1370.0], [965.0, 1393.0], [169.0, 1389.0]], "text": "样的。金属中的自由电荷就是自由电子。在电解液中，自由电荷不是电子而", "confidence": 0.9991461887504115}]