[{"box": [[419.0, 98.0], [720.0, 98.0], [720.0, 121.0], [419.0, 121.0]], "text": "81.静电的基本现象和基本规律", "confidence": 0.9516303360462188}, {"box": [[942.0, 100.0], [958.0, 100.0], [958.0, 120.0], [942.0, 120.0]], "text": "5", "confidence": 0.9995908141136169}, {"box": [[171.0, 160.0], [963.0, 160.0], [963.0, 183.0], [171.0, 183.0]], "text": "是溶解在其中的酸、碱、盐等溶质分子离解成的正、负离子。在电离的气体", "confidence": 0.9989987142158278}, {"box": [[170.0, 196.0], [965.0, 196.0], [965.0, 219.0], [170.0, 219.0]], "text": "）", "confidence": 0.7126916646957397}, {"box": [[169.0, 230.0], [330.0, 230.0], [330.0, 253.0], [169.0, 253.0]], "text": "往往就是电子。", "confidence": 0.9988673073904855}, {"box": [[220.0, 263.0], [965.0, 263.0], [965.0, 286.0], [220.0, 286.0]], "text": "在绝缘体中，绝大部分电荷都只能在一个原子或分子的范围内作微小", "confidence": 0.9988470474878947}, {"box": [[169.0, 296.0], [963.0, 297.0], [963.0, 321.0], [169.0, 320.0]], "text": "的位移。这种电荷叫做束缚电荷。由于绝缘体中自由电子很少，所以它们的", "confidence": 0.9981090173576818}, {"box": [[169.0, 329.0], [332.0, 331.0], [331.0, 358.0], [169.0, 355.0]], "text": "导电性能很差。", "confidence": 0.9998894589287894}, {"box": [[218.0, 363.0], [966.0, 364.0], [966.0, 390.0], [218.0, 389.0]], "text": "在半导体中导电的粒子（叫做载流子），除带负电的电子外，还有带正", "confidence": 0.9982629514509632}, {"box": [[169.0, 398.0], [967.0, 399.0], [967.0, 425.0], [169.0, 424.0]], "text": "电的“空穴”。当半导体中多数载流子是电子时，称为N型半导体；当多数载", "confidence": 0.9952377659433028}, {"box": [[170.0, 435.0], [965.0, 435.0], [965.0, 457.0], [170.0, 457.0]], "text": "流子是“空穴”时，称为P型半导体。将N型和P型半导体结合起来，可以制", "confidence": 0.9927444282700034}, {"box": [[171.0, 467.0], [964.0, 467.0], [964.0, 490.0], [171.0, 490.0]], "text": "成各种半导体器件，如晶体二极管、晶体三极管等，它们在现代电子技术中", "confidence": 0.9848339340903542}, {"box": [[170.0, 501.0], [355.0, 501.0], [355.0, 524.0], [170.0, 524.0]], "text": "有着广泛的应用。", "confidence": 0.9997690767049789}, {"box": [[221.0, 534.0], [965.0, 536.0], [965.0, 560.0], [221.0, 557.0]], "text": "上述物质结构的图像表明，电荷的量值是离散的（近代物理学中把这", "confidence": 0.9983121017615001}, {"box": [[170.0, 566.0], [966.0, 568.0], [966.0, 594.0], [170.0, 592.0]], "text": "叫做“量子化的”）。电荷的量值有个基本单元，即一个质子或一个电子所带", "confidence": 0.9959715622312882}, {"box": [[168.0, 600.0], [965.0, 603.0], [965.0, 629.0], [168.0, 626.0]], "text": "电量的绝对值e，每个原子核、原子或离子、分子，以至宏观物体所带的电", "confidence": 0.9913886713259148}, {"box": [[169.0, 637.0], [964.0, 638.0], [964.0, 661.0], [169.0, 660.0]], "text": "量，都只能是这个元电荷e的整数倍。这个常量是由实验测定的，根据1999", "confidence": 0.9980063455445426}, {"box": [[169.0, 670.0], [555.0, 671.0], [555.0, 695.0], [169.0, 694.0]], "text": "年发布的数据，这个元电荷的量值为", "confidence": 0.9996883571147919}, {"box": [[385.0, 705.0], [749.0, 705.0], [749.0, 731.0], [385.0, 731.0]], "text": "e = 1.602176462(83)x10-l\"C,", "confidence": 0.87916816495083}, {"box": [[171.0, 739.0], [317.0, 739.0], [317.0, 762.0], [171.0, 762.0]], "text": "它的近似值为", "confidence": 0.9994251827398936}, {"box": [[452.0, 772.0], [682.0, 772.0], [682.0, 798.0], [452.0, 798.0]], "text": "e = 1.602 x10-\" C,", "confidence": 0.8229504906468921}, {"box": [[169.0, 807.0], [965.0, 810.0], [965.0, 836.0], [169.0, 833.0]], "text": "C（库仑）是电量的单位，它的定义将在后文阐述。不过根据上式我们也可以", "confidence": 0.9974661960321314}, {"box": [[172.0, 846.0], [443.0, 846.0], [443.0, 868.0], [172.0, 868.0]], "text": "说，1C的电量是元电荷的", "confidence": 0.9944151192903519}, {"box": [[454.0, 882.0], [476.0, 882.0], [476.0, 904.0], [454.0, 904.0]], "text": "1", "confidence": 0.9979408383369446}, {"box": [[386.0, 904.0], [745.0, 880.0], [748.0, 926.0], [389.0, 950.0]], "text": "1. 602 × 10-19 = 6. 24 × 1018 倍。", "confidence": 0.946686833165586}, {"box": [[167.0, 952.0], [314.0, 955.0], [313.0, 981.0], [167.0, 979.0]], "text": "1.5库仑定律", "confidence": 0.9981232285499573}, {"box": [[218.0, 996.0], [965.0, 1000.0], [965.0, 1026.0], [218.0, 1022.0]], "text": "发现电现象后两千多年的长时期内，人们对电的了解一直处于定性的", "confidence": 0.9985117336114248}, {"box": [[170.0, 1035.0], [964.0, 1038.0], [964.0, 1062.0], [170.0, 1059.0]], "text": "初级阶段。这是因为，一方面社会生产力的发展还没有提出应用电力的急迫", "confidence": 0.999220017230872}, {"box": [[168.0, 1069.0], [966.0, 1073.0], [966.0, 1099.0], [168.0, 1095.0]], "text": "需要，另一方面，人们对电的规律的研究必须借助于较精密的仪器，这也只", "confidence": 0.9988001223766443}, {"box": [[169.0, 1107.0], [965.0, 1110.0], [965.0, 1136.0], [169.0, 1133.0]], "text": "有在生产水平达到一定高度时才能实现。这种状况一直延续很久，到了19", "confidence": 0.9979018568992615}, {"box": [[169.0, 1144.0], [784.0, 1147.0], [784.0, 1172.0], [169.0, 1169.0]], "text": "世纪人们才开始对电的规律及其本质有比较深人的了解。", "confidence": 0.9996592760086059}, {"box": [[218.0, 1179.0], [966.0, 1183.0], [966.0, 1209.0], [218.0, 1205.0]], "text": "最早的定量研究是在18世纪末，库仑通过实验总结出两个静止点电荷", "confidence": 0.9965582682240394}, {"box": [[168.0, 1215.0], [966.0, 1220.0], [966.0, 1246.0], [168.0, 1241.0]], "text": "间相互作用的规律，现称之为库仑定律。所谓点电荷，是指这样的带电体，它", "confidence": 0.9979569526279674}, {"box": [[168.0, 1253.0], [966.0, 1257.0], [966.0, 1282.0], [168.0, 1278.0]], "text": "本身的几何线度比起它到其它带电体的距离小得多。这种带电体的形状和", "confidence": 0.998003987595439}, {"box": [[167.0, 1289.0], [916.0, 1293.0], [916.0, 1319.0], [167.0, 1315.0]], "text": "电荷在其中的分布已无关紧要，因此我们可以把它抽象成一个几何点。", "confidence": 0.9989886726102521}, {"box": [[218.0, 1325.0], [432.0, 1328.0], [432.0, 1355.0], [217.0, 1352.0]], "text": "库仑定律表述如下：", "confidence": 0.9990732007556491}, {"box": [[218.0, 1363.0], [963.0, 1367.0], [963.0, 1393.0], [218.0, 1389.0]], "text": "在真空中，两个静止的点电荷4和42之间的相互作用力的大小和q与", "confidence": 0.9599561162533299}]