[{"box": [[541.0, 166.0], [584.0, 166.0], [584.0, 203.0], [541.0, 203.0]], "text": "序", "confidence": 0.9984320998191833}, {"box": [[218.0, 262.0], [961.0, 262.0], [961.0, 285.0], [218.0, 285.0]], "text": "从教学顺序上看，本书是《新概念物理教程》中的第三卷。全套书各卷", "confidence": 0.9992437093488632}, {"box": [[167.0, 300.0], [962.0, 300.0], [962.0, 323.0], [167.0, 323.0]], "text": "的编写和改革思路是一脉相承的，但根据内容的特点，各卷的情况有所不", "confidence": 0.9990309625864029}, {"box": [[167.0, 337.0], [962.0, 337.0], [962.0, 359.0], [167.0, 359.0]], "text": "同。继力学课之后，电磁学是普通物理系列中最重要的基础课。电磁学中最", "confidence": 0.9993815747174349}, {"box": [[167.0, 375.0], [961.0, 375.0], [961.0, 395.0], [167.0, 395.0]], "text": "重要的概念是“场”。场与质点不同，是在空间具有连续分布的客体，它的规", "confidence": 0.9890979265465456}, {"box": [[166.0, 410.0], [962.0, 410.0], [962.0, 433.0], [166.0, 433.0]], "text": "律要从整体上去把握。场在空间的分布不一定直接与场源相联系，邻近各点", "confidence": 0.9887415694467949}, {"box": [[167.0, 447.0], [962.0, 447.0], [962.0, 469.0], [167.0, 469.0]], "text": "之间场的分布也是紧密相关的。描述和处理“场”所需的概念（如通量、环", "confidence": 0.997891827063127}, {"box": [[168.0, 484.0], [961.0, 484.0], [961.0, 504.0], [168.0, 504.0]], "text": "量）和方法与学生过去熟悉的大不相同。学生在电磁学课中第一次系统地", "confidence": 0.999162083491683}, {"box": [[166.0, 518.0], [962.0, 520.0], [962.0, 543.0], [166.0, 541.0]], "text": "学到“场”的概念和处理“场”的方法。按现代物理学的观点，粒子不过是场", "confidence": 0.9962508134982165}, {"box": [[167.0, 557.0], [962.0, 557.0], [962.0, 579.0], [167.0, 579.0]], "text": "的激发态，“场”的概念比“粒子”更基本。通过“场”产生相互作用的观点是", "confidence": 0.9938580070223128}, {"box": [[168.0, 593.0], [488.0, 593.0], [488.0, 616.0], [168.0, 616.0]], "text": "与现代物理学的精神相通的。", "confidence": 0.9998659445689275}, {"box": [[217.0, 629.0], [962.0, 630.0], [962.0, 654.0], [217.0, 653.0]], "text": "我们曾在20多年前编写过一本《电磁学》教材，在全国范围内得到相", "confidence": 0.9989359878724621}, {"box": [[169.0, 667.0], [962.0, 667.0], [962.0, 690.0], [169.0, 690.0]], "text": "当广泛的采用，并且沿用至今，势头未减。本书就是在那本书的基础上改写", "confidence": 0.9993818998336792}, {"box": [[166.0, 702.0], [962.0, 703.0], [962.0, 726.0], [166.0, 725.0]], "text": "的。这次改写的时候我们面临的问题是保留什么？改什么？无疑，无论在内容", "confidence": 0.9897989963783937}, {"box": [[166.0, 739.0], [963.0, 741.0], [963.0, 763.0], [166.0, 761.0]], "text": "的取舍、叙述的条理、概念的分析等方面，凡经得住教学实践的考验，而用现", "confidence": 0.998435749727137}, {"box": [[165.0, 775.0], [963.0, 777.0], [963.0, 800.0], [165.0, 798.0]], "text": "代的观点审视又不陈旧过时的，都应该保留。在本套《新概念物理教程》中，", "confidence": 0.9992186760201174}, {"box": [[164.0, 812.0], [962.0, 814.0], [962.0, 837.0], [164.0, 835.0]], "text": "作为现代的观点，强调了对称性原理和守恒量的应用。对称性分析在普通物", "confidence": 0.99972992774212}, {"box": [[165.0, 849.0], [963.0, 851.0], [963.0, 873.0], [165.0, 871.0]], "text": "理各门课里要数电磁学中用得最多，但过去的讲法以具体的物理定律（如", "confidence": 0.9990801196545362}, {"box": [[166.0, 885.0], [962.0, 887.0], [962.0, 910.0], [166.0, 908.0]], "text": "库仑定律、毕奥一萨伐尔定律）为据，就事论事地讨论问题，而未从层次更高", "confidence": 0.9911151072558235}, {"box": [[166.0, 922.0], [962.0, 924.0], [962.0, 947.0], [166.0, 945.0]], "text": "的对称性原理出发，做更简洁、普适性更广的讨论。这次成书时我们改过来", "confidence": 0.9990620703408213}, {"box": [[168.0, 959.0], [963.0, 961.0], [963.0, 983.0], [168.0, 981.0]], "text": "了。此外，过去镜像对称性这一威力强大的武器几乎没被利用过，本书中我", "confidence": 0.9967951196612734}, {"box": [[167.0, 995.0], [963.0, 998.0], [963.0, 1021.0], [167.0, 1018.0]], "text": "们强调了这方面的应用。至于守恒量，电磁学从来就重视电势与能量的讨", "confidence": 0.9996530786156654}, {"box": [[165.0, 1033.0], [962.0, 1035.0], [962.0, 1058.0], [165.0, 1056.0]], "text": "论，但局限于标势，对磁矢势介绍得很少，并且对电磁动量与磁矢势的关系", "confidence": 0.997105112581542}, {"box": [[166.0, 1069.0], [962.0, 1072.0], [962.0, 1095.0], [166.0, 1092.0]], "text": "基本上未涉及到。这次成书时我们增加了有关内容。再者，本书对原书的章", "confidence": 0.9996853380492239}, {"box": [[166.0, 1105.0], [962.0, 1108.0], [962.0, 1132.0], [166.0, 1129.0]], "text": "节做了些合并与调整，使相关内容（如电介质和磁介质，直流电路与交流电", "confidence": 0.9985080578110435}, {"box": [[165.0, 1141.0], [965.0, 1144.0], [965.0, 1170.0], [165.0, 1166.0]], "text": "路）叙述起来更紧凑。对一些太技术性的问题和过时的仪器设备做了删除。", "confidence": 0.9941480629371874}, {"box": [[166.0, 1178.0], [962.0, 1180.0], [962.0, 1204.0], [166.0, 1202.0]], "text": "电磁学的历史，从麦克斯韦算起少说也有150年了，至今生命力不衰。本书", "confidence": 0.9990799391970915}, {"box": [[165.0, 1215.0], [962.0, 1218.0], [962.0, 1242.0], [165.0, 1239.0]], "text": "对电磁学的前沿要不要有更多的反映？经典电磁学的前沿早已成为应用性", "confidence": 0.9964930433779955}, {"box": [[166.0, 1252.0], [962.0, 1256.0], [962.0, 1278.0], [166.0, 1274.0]], "text": "学科，如电工学、电子学的内容，在基础物理课中不宜过多介绍。量子方面", "confidence": 0.9987898794087496}, {"box": [[162.0, 1288.0], [962.0, 1291.0], [962.0, 1315.0], [162.0, 1312.0]], "text": "呢？在这些问题中多涉及量子力学的基本概念，除了新闻式的报导外，很难", "confidence": 0.9949957204587532}, {"box": [[165.0, 1325.0], [963.0, 1328.0], [963.0, 1353.0], [165.0, 1350.0]], "text": "对未学过量子力学或《新概念物理教程·量子物理》卷的学生，做稍微本质", "confidence": 0.9991272001555471}, {"box": [[165.0, 1363.0], [914.0, 1366.0], [914.0, 1388.0], [165.0, 1385.0]], "text": "一点的介绍。加之本卷《电磁学》已经很厚了，这方面的内容只好割爱。", "confidence": 0.9991150833666325}]