[{"box": [[552.0, 96.0], [583.0, 96.0], [583.0, 126.0], [552.0, 126.0]], "text": "序", "confidence": 0.9975065588951111}, {"box": [[937.0, 101.0], [954.0, 101.0], [954.0, 122.0], [937.0, 122.0]], "text": "Ⅲ", "confidence": 0.9183478355407715}, {"box": [[219.0, 161.0], [964.0, 161.0], [964.0, 187.0], [219.0, 187.0]], "text": "本卷《电磁学》在《新概念物理教程》各卷中也许显得比传统的变化少", "confidence": 0.9996679329103039}, {"box": [[173.0, 199.0], [950.0, 199.0], [950.0, 225.0], [173.0, 225.0]], "text": "了一些。我们发现费曼在他著名的《物理学讲义》序言中有这样的话：“.…·", "confidence": 0.9525919130870274}, {"box": [[170.0, 234.0], [967.0, 235.0], [967.0, 261.0], [170.0, 260.0]], "text": "尽管我想，就物理内容而言，第-一年课程制订得还相当满意。第二年我就不", "confidence": 0.9921416570158565}, {"box": [[170.0, 270.0], [966.0, 271.0], [966.0, 297.0], [170.0, 296.0]], "text": "那么满意了。课程的前半部分讨论的是电和磁，我想不出什么比通常更令人", "confidence": 0.999479515986009}, {"box": [[169.0, 308.0], [970.0, 309.0], [970.0, 335.0], [169.0, 334.0]], "text": "激动的独特而不同的方式去讲述。”可能这就是实际情况，我们应当尊重。", "confidence": 0.9995868820132632}, {"box": [[169.0, 344.0], [633.0, 345.0], [633.0, 371.0], [169.0, 370.0]], "text": "在教学改革中实事求是的精神是很必要的。", "confidence": 0.9998565504425451}, {"box": [[217.0, 381.0], [965.0, 382.0], [965.0, 408.0], [217.0, 407.0]], "text": "《电磁学》原书是两人共同编写的。本卷的改写，陈熙谋除对整体参与", "confidence": 0.9997283374109576}, {"box": [[172.0, 417.0], [968.0, 419.0], [968.0, 445.0], [172.0, 443.0]], "text": "了一些重要意见和提供-些片段外，主要重写了第五章，其余工作由赵凯华", "confidence": 0.9839997201254873}, {"box": [[168.0, 453.0], [237.0, 453.0], [237.0, 481.0], [168.0, 481.0]], "text": "完成。", "confidence": 0.9997657934824625}, {"box": [[807.0, 560.0], [874.0, 560.0], [874.0, 592.0], [807.0, 592.0]], "text": "作者", "confidence": 0.9998398721218109}, {"box": [[778.0, 597.0], [895.0, 599.0], [894.0, 627.0], [777.0, 625.0]], "text": "2002年炎暑", "confidence": 0.9777353320802961}]