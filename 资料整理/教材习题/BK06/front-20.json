[{"box": [[267.0, 134.0], [635.0, 132.0], [635.0, 158.0], [267.0, 160.0]], "text": "第一章实验基础与基本原理", "confidence": 0.9999057749907175}, {"box": [[166.0, 181.0], [774.0, 177.0], [774.0, 201.0], [167.0, 204.0]], "text": "本章是全书开宗明义第一章，如果说全书将带领读者到量子王国去游", "confidence": 0.9988739212354024}, {"box": [[126.0, 211.0], [774.0, 207.0], [774.0, 229.0], [126.0, 233.0]], "text": "览的话，本章是一张导游图。量子王国地处微观世界，那里的一切对于我们", "confidence": 0.9983556686025677}, {"box": [[126.0, 270.0], [772.0, 267.0], [772.0, 287.0], [126.0, 290.0]], "text": "“风土人情”是相当困难的。我们必须“人邦问俗”，最好先粗通量子物理的", "confidence": 0.9907514470465043}, {"box": [[128.0, 300.0], [704.0, 297.0], [704.0, 318.0], [128.0, 320.0]], "text": "术语和理论架构，再进入各个具体问题的讨论时，会感到主动一些。", "confidence": 0.9966747025648753}, {"box": [[167.0, 326.0], [773.0, 325.0], [773.0, 348.0], [167.0, 349.0]], "text": "本章的前两节介绍量子论的实验基础。这些实验表明，经典物理中一些", "confidence": 0.9988188339817908}, {"box": [[125.0, 356.0], [773.0, 354.0], [773.0, 377.0], [125.0, 379.0]], "text": "熟知的概念行不通了。本来光已被公认为电磁波，却在一些场合表现得像", "confidence": 0.9993298202753067}, {"box": [[126.0, 385.0], [773.0, 385.0], [773.0, 405.0], [126.0, 405.0]], "text": "“粒子”。于是有人猜测，电子是公认的粒子，会不会也有“波动性”？果真被", "confidence": 0.9952359080314637}, {"box": [[128.0, 444.0], [772.0, 444.0], [772.0, 464.0], [128.0, 464.0]], "text": "到荒诞和神秘）的概念，导致了量子力学的建立。从本章83起我们逐步引", "confidence": 0.974814848466353}, {"box": [[127.0, 473.0], [459.0, 473.0], [459.0, 493.0], [127.0, 493.0]], "text": "人量子力学最基本的概念和理论架构。", "confidence": 0.9776184068006628}, {"box": [[168.0, 503.0], [771.0, 503.0], [771.0, 522.0], [168.0, 522.0]], "text": "在经典物理中物理量具有确定的量值，服从一定的规律。而量子力学中", "confidence": 0.9977787213940774}, {"box": [[127.0, 560.0], [772.0, 562.0], [772.0, 582.0], [127.0, 580.0]], "text": "动力学变量有多个“本征值”，测量它们时并不得到确定的量值，而是以一", "confidence": 0.9965204018535037}, {"box": [[125.0, 588.0], [773.0, 589.0], [773.0, 612.0], [125.0, 611.0]], "text": "定的概率得到它们的某个本征值。概率是用“概率幅”来描述的，概率幅是", "confidence": 0.9976356517184864}, {"box": [[126.0, 618.0], [773.0, 620.0], [773.0, 640.0], [126.0, 638.0]], "text": "复数，它的模方才是概率。概率幅具有模量和相角，叠加时可以产生干涉。", "confidence": 0.9983108946771333}, {"box": [[125.0, 646.0], [773.0, 647.0], [773.0, 671.0], [125.0, 670.0]], "text": "够了，这些名词和概念已经是经典物理中闻所未闻、见所未见的，且不说其", "confidence": 0.9992305979584203}, {"box": [[125.0, 676.0], [772.0, 677.0], [772.0, 700.0], [125.0, 699.0]], "text": "它一些更奥妙的东西了。我们将在本章S3中初步引人“概率幅”的概念，", "confidence": 0.9766481031071056}, {"box": [[125.0, 733.0], [774.0, 735.0], [774.0, 758.0], [125.0, 756.0]], "text": "在本章8～10中介绍一些后面几章将用到的概念之后，最后在11里", "confidence": 0.9962098021661082}, {"box": [[126.0, 763.0], [772.0, 765.0], [772.0, 787.0], [126.0, 785.0]], "text": "为本章学到的量子力学基本原理做一个小结。这样，我们就取得了进人后面", "confidence": 0.9888744047193816}, {"box": [[126.0, 789.0], [282.0, 793.0], [282.0, 816.0], [125.0, 813.0]], "text": "各章的“人场券”。", "confidence": 0.9839909142918057}, {"box": [[261.0, 836.0], [640.0, 836.0], [640.0, 859.0], [261.0, 859.0]], "text": "81.热辐射与普朗克的量子假说", "confidence": 0.9957193970680237}, {"box": [[123.0, 882.0], [425.0, 884.0], [424.0, 908.0], [123.0, 906.0]], "text": "1.1一般特征与辐射场的定量描述", "confidence": 0.9992184974253178}, {"box": [[164.0, 917.0], [773.0, 920.0], [773.0, 943.0], [163.0, 940.0]], "text": "把铁条插在炉火中，它会被烧得通红。起初在温度不太高时，我们看不", "confidence": 0.9994303814826473}, {"box": [[124.0, 947.0], [771.0, 949.0], [771.0, 969.0], [124.0, 967.0]], "text": "到它发光，却可感到它辐射出来的热量。当温度达到500°C左右时，铁条开", "confidence": 0.9932304842131479}, {"box": [[124.0, 974.0], [772.0, 977.0], [772.0, 1000.0], [124.0, 997.0]], "text": "始发出可见的光辉。随着温度的升高，不但光的强度逐渐增大，颜色也由暗", "confidence": 0.9990899924075964}, {"box": [[124.0, 1004.0], [771.0, 1007.0], [771.0, 1028.0], [124.0, 1025.0]], "text": "红转为橙红。以上是我们日常生活中熟知的现象，它们反映了热辐射的一般", "confidence": 0.9993897513909773}, {"box": [[123.0, 1033.0], [772.0, 1037.0], [772.0, 1059.0], [123.0, 1055.0]], "text": "特征，即随着温度的升高，（1）辐射的总功率增大；（2）强度在光谱中的分", "confidence": 0.9940732002258301}, {"box": [[124.0, 1062.0], [772.0, 1065.0], [772.0, 1088.0], [124.0, 1085.0]], "text": "布由长波向短波转移。热辐射不一定需要高温，实际上，任何温度（室温或", "confidence": 0.9954951044284936}, {"box": [[124.0, 1091.0], [770.0, 1094.0], [770.0, 1117.0], [124.0, 1114.0]], "text": "更低)的物体都发出一定的热辐射，只不过在低温下辐射不强，且其中包含", "confidence": 0.98917397405162}]