[{"box": [[440.0, 130.0], [473.0, 130.0], [473.0, 158.0], [440.0, 158.0]], "text": "序", "confidence": 0.997899055480957}, {"box": [[172.0, 204.0], [778.0, 207.0], [778.0, 229.0], [172.0, 226.0]], "text": "从教学顺序上看，本书是《新概念物理教程》中的第五卷，全套书各卷", "confidence": 0.9992832195374274}, {"box": [[131.0, 233.0], [779.0, 237.0], [779.0, 259.0], [131.0, 255.0]], "text": "的编写和改革思路是一脉相承的，但根据内容的特点，本卷更加强调用普通", "confidence": 0.999400131630175}, {"box": [[130.0, 262.0], [389.0, 264.0], [389.0, 287.0], [129.0, 285.0]], "text": "物理课的风格讲述量子物理。", "confidence": 0.9998256380741413}, {"box": [[169.0, 291.0], [779.0, 296.0], [779.0, 319.0], [168.0, 315.0]], "text": "本书不是“量子力学”教材。本书由实验事实出发，从特殊到一般引入", "confidence": 0.9984011957722325}, {"box": [[131.0, 322.0], [777.0, 326.0], [777.0, 347.0], [131.0, 343.0]], "text": "一些概念，较多地注重形象化和直观性，不追求逻辑上的严格性和理论上的", "confidence": 0.9992314757722797}, {"box": [[129.0, 350.0], [778.0, 355.0], [778.0, 378.0], [129.0, 373.0]], "text": "完整性和系统性。在数学工具上，本书几乎从头起就运用狄拉克符号和矩", "confidence": 0.9980316795408726}, {"box": [[129.0, 381.0], [777.0, 386.0], [777.0, 406.0], [129.0, 401.0]], "text": "阵来表示，采用了与通常量子力学中以偏微分方程为基础所不同的甚至颠", "confidence": 0.9987835604697466}, {"box": [[128.0, 409.0], [778.0, 415.0], [778.0, 437.0], [128.0, 432.0]], "text": "倒了的讲述体系。书中只介绍量子力学的基本概念和架构，不涉及量子力学", "confidence": 0.9993802778648607}, {"box": [[129.0, 439.0], [777.0, 444.0], [777.0, 467.0], [128.0, 462.0]], "text": "中许多基本而重要的计算方法。所以，物理专业的学生在学习了本卷教材之", "confidence": 0.9993315646142671}, {"box": [[129.0, 468.0], [778.0, 474.0], [778.0, 497.0], [128.0, 491.0]], "text": "后，必须再学习作为理论物理课的“量子力学”。在制订物理专业的教学计", "confidence": 0.9987760366815509}, {"box": [[128.0, 497.0], [777.0, 503.0], [777.0, 526.0], [127.0, 520.0]], "text": "划时，我们往往遇到一个困难，即有些重要课程，如固体物理、原子核物理", "confidence": 0.999289642680775}, {"box": [[128.0, 528.0], [776.0, 535.0], [776.0, 556.0], [127.0, 550.0]], "text": "等，需要等待量子力学课先行而不得不排得相当靠后。我们相信，在学生读", "confidence": 0.9992654197143785}, {"box": [[129.0, 558.0], [776.0, 565.0], [776.0, 585.0], [128.0, 578.0]], "text": "了本卷教材之后，上述课程就不必等量子力学之后再开设了，这将给教学计", "confidence": 0.9988512143944249}, {"box": [[126.0, 586.0], [775.0, 593.0], [775.0, 616.0], [125.0, 609.0]], "text": "划的制订带来相当大的灵活性。此外，本卷教材的学习，也对物理类专业的", "confidence": 0.9992492524060336}, {"box": [[126.0, 616.0], [403.0, 619.0], [402.0, 640.0], [125.0, 637.0]], "text": "学生做近代物理实验大有帮助。", "confidence": 0.9998728845800672}, {"box": [[166.0, 645.0], [775.0, 653.0], [775.0, 675.0], [165.0, 668.0]], "text": "传统上普通物理课的第五部分是“原子物理”，本书与原子物理教材也", "confidence": 0.9990488290786743}, {"box": [[126.0, 676.0], [774.0, 683.0], [774.0, 703.0], [126.0, 696.0]], "text": "大有区别。本书一改国内多年来原子物理教材以原子光谱和玻尔旧量子论", "confidence": 0.9989239200949669}, {"box": [[126.0, 705.0], [773.0, 712.0], [773.0, 733.0], [125.0, 726.0]], "text": "为主线的模式，而是从头起就用量子力学的基本概念和语言，较全面地介绍", "confidence": 0.9988117868250067}, {"box": [[127.0, 734.0], [772.0, 742.0], [772.0, 762.0], [126.0, 754.0]], "text": "了当代量子物理的方方面面，除原子物理课程传统内容外，还介绍了诸如量", "confidence": 0.9990106188889706}, {"box": [[125.0, 763.0], [773.0, 771.0], [773.0, 794.0], [124.0, 787.0]], "text": "子共振、势垒隧穿、能带、半导体、声子与元激发、超导体、AB效应、约瑟夫", "confidence": 0.9990633078983852}, {"box": [[125.0, 794.0], [772.0, 802.0], [772.0, 823.0], [124.0, 815.0]], "text": "森结、分子轨函及其杂化等，并作为窗口，简单介绍了量子态交缠、薛定谔猫", "confidence": 0.9970669886645149}, {"box": [[124.0, 823.0], [774.0, 831.0], [774.0, 853.0], [123.0, 845.0]], "text": "态的实验实现、贝尔不等式实验检验、量子超空间传态与量子计算等近年来", "confidence": 0.9994388060136274}, {"box": [[124.0, 853.0], [772.0, 861.0], [772.0, 881.0], [123.0, 873.0]], "text": "量子物理的最新进展。但是从课程的衔接来说，本书只要求读者学过普通物", "confidence": 0.9970527399669994}, {"box": [[123.0, 881.0], [773.0, 890.0], [772.0, 913.0], [122.0, 904.0]], "text": "理的光学部分、微积分和线性代数。对学时的要求和原子物理课程大致相", "confidence": 0.9989443179219961}, {"box": [[123.0, 910.0], [169.0, 914.0], [167.0, 936.0], [121.0, 932.0]], "text": "仿。", "confidence": 0.9991017878055573}, {"box": [[159.0, 941.0], [772.0, 949.0], [771.0, 972.0], [158.0, 964.0]], "text": "20世纪是科学技术空前迅猛发展的世纪，在此世纪内，人类社会在科", "confidence": 0.9963681313299364}, {"box": [[122.0, 969.0], [771.0, 978.0], [770.0, 1001.0], [121.0, 992.0]], "text": "技进步上经历了一个又一个划时代的变革。继19世纪的物理学把人类社", "confidence": 0.9987332932651043}, {"box": [[121.0, 999.0], [771.0, 1009.0], [770.0, 1031.0], [120.0, 1021.0]], "text": "会带进“电气化时代”以后，20世纪40年代物理学又使人类掌握了核能的", "confidence": 0.9978538681479061}, {"box": [[122.0, 1030.0], [770.0, 1040.0], [769.0, 1060.0], [121.0, 1050.0]], "text": "奥秘，把人类社会带进“原子时代”。今天核技术的应用远不止于为社会提", "confidence": 0.9964410626527035}, {"box": [[120.0, 1058.0], [770.0, 1067.0], [769.0, 1090.0], [119.0, 1081.0]], "text": "供长久可靠的能源，放射性与核磁共振在医学上的诊断与治疗作用，已几乎", "confidence": 0.9982502334045641}, {"box": [[121.0, 1088.0], [770.0, 1097.0], [769.0, 1119.0], [120.0, 1110.0]], "text": "家喻户晓。20世纪五六十年代物理学家又发明了激光，现在激光已广泛应", "confidence": 0.9973902973261747}]