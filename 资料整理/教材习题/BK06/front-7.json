[{"box": [[437.0, 82.0], [459.0, 82.0], [459.0, 102.0], [437.0, 102.0]], "text": "序", "confidence": 0.9982049465179443}, {"box": [[746.0, 85.0], [764.0, 85.0], [764.0, 103.0], [746.0, 103.0]], "text": "Ⅲ", "confidence": 0.9004915952682495}, {"box": [[123.0, 128.0], [772.0, 132.0], [772.0, 155.0], [123.0, 151.0]], "text": "用于尖端科学研究、工业、农业、医学、通讯、计算、军事和家庭生活。20世", "confidence": 0.9995331508772713}, {"box": [[122.0, 157.0], [771.0, 162.0], [771.0, 186.0], [122.0, 180.0]], "text": "纪科学技术给人类社会所带来的最大冲击，莫过于以现代计算机为基础发", "confidence": 0.9996079746633768}, {"box": [[122.0, 187.0], [771.0, 192.0], [771.0, 215.0], [122.0, 210.0]], "text": "展起来的电子信息技术。号称“信息时代”的到来被誉为“第三次产业革", "confidence": 0.9978806208819151}, {"box": [[122.0, 216.0], [770.0, 222.0], [770.0, 245.0], [122.0, 239.0]], "text": "命”。的确，计算机给人类社会带来如此深刻的变化，是二三十年前任何有", "confidence": 0.9995511896682509}, {"box": [[121.0, 245.0], [769.0, 251.0], [768.0, 274.0], [121.0, 268.0]], "text": "远见的科学家都不可能预见到的。现代计算机的硬件基础是半导体集成电", "confidence": 0.9998276084661484}, {"box": [[122.0, 275.0], [768.0, 281.0], [768.0, 303.0], [122.0, 296.0]], "text": "路，PN结是核心。1947年晶体管的发明，标志着信息时代的发端。所有上", "confidence": 0.9995163372584752}, {"box": [[120.0, 304.0], [769.0, 312.0], [768.0, 334.0], [120.0, 327.0]], "text": "述一切，无不建立在量子物理的基础上，或是在量子物理的概念中衍生出", "confidence": 0.9991324376314878}, {"box": [[121.0, 335.0], [769.0, 343.0], [768.0, 363.0], [121.0, 355.0]], "text": "来的。此外，众多交叉学科的领域，像量子化学、量子生物学、量子宇宙学，也", "confidence": 0.9978648815836225}, {"box": [[119.0, 363.0], [771.0, 371.0], [770.0, 394.0], [119.0, 386.0]], "text": "都立足于量子物理这块奠基石上。我们可以毫不夸大地说，没有量子物理，", "confidence": 0.998221628593676}, {"box": [[119.0, 392.0], [375.0, 396.0], [374.0, 420.0], [118.0, 415.0]], "text": "就没有我们今天的生活方式。", "confidence": 0.9991168471483084}, {"box": [[158.0, 422.0], [766.0, 431.0], [765.0, 454.0], [157.0, 446.0]], "text": "今年是普朗克的量子论诞生100周年，从1925年或1926年算起量子力", "confidence": 0.9988699197769165}, {"box": [[117.0, 452.0], [767.0, 461.0], [766.0, 484.0], [116.0, 475.0]], "text": "学的建立也近3/4个世纪了。然而时至今日，我们的基础物理课中量子物理", "confidence": 0.998600530273774}, {"box": [[118.0, 481.0], [767.0, 491.0], [766.0, 513.0], [117.0, 503.0]], "text": "的内容在许多地方只一带而过，即使在“原子物理”部分，如何处理旧量子", "confidence": 0.9980852314920137}, {"box": [[117.0, 510.0], [765.0, 520.0], [764.0, 543.0], [116.0, 532.0]], "text": "论与真正的量子力学之争，迄今未尝休止。人们说“近代物理”早已不“近", "confidence": 0.9923310478528341}, {"box": [[117.0, 539.0], [766.0, 550.0], [765.0, 573.0], [116.0, 563.0]], "text": "代”了。像量子物理这样重要的内容，在基础物理课程中应占有适当的地", "confidence": 0.9994383696466684}, {"box": [[116.0, 571.0], [765.0, 581.0], [764.0, 601.0], [116.0, 591.0]], "text": "位。这个问题之所以迟迟不能解决，是因为以偏微分方程为基础的那套量子", "confidence": 0.9973387772386725}, {"box": [[116.0, 599.0], [764.0, 609.0], [763.0, 632.0], [115.0, 622.0]], "text": "力学理论体系，对学生预备知识的要求实在太高了。固然准备学物理的学生", "confidence": 0.999705666845495}, {"box": [[116.0, 628.0], [764.0, 639.0], [763.0, 662.0], [115.0, 650.0]], "text": "可以等到高年级再学量子力学，但是对于大多数非物理专业的学生来说，基", "confidence": 0.9995408491654829}, {"box": [[114.0, 657.0], [763.0, 669.0], [762.0, 691.0], [113.0, 680.0]], "text": "础物理课是他们的最后一门物理课。科学家预言，在21世纪中，对于我们的", "confidence": 0.9989414197557113}, {"box": [[114.0, 687.0], [763.0, 698.0], [762.0, 721.0], [113.0, 710.0]], "text": "孩子和孩子的孩子来说，量子力学的概念将成为一种常识。若上述情况长此", "confidence": 0.9986411766572432}, {"box": [[114.0, 717.0], [762.0, 729.0], [761.0, 751.0], [113.0, 739.0]], "text": "以往，那怎么可能？话又说回来，考入大学物理系的学生，许多是中学里的", "confidence": 0.999169358701417}, {"box": [[114.0, 747.0], [761.0, 758.0], [760.0, 780.0], [113.0, 768.0]], "text": "依依者，他们对物理，特别是近代物理的各种激动人心的成就，满怀激情和", "confidence": 0.9846122048117898}, {"box": [[112.0, 775.0], [761.0, 788.0], [760.0, 811.0], [111.0, 799.0]], "text": "兴趣。如果进得大学大门来，两年之内尽和一些滑轮、斜面和经典电路之类", "confidence": 0.9993774349039252}, {"box": [[113.0, 806.0], [760.0, 817.0], [759.0, 839.0], [112.0, 828.0]], "text": "的东西打交道，他们会不会感到失望？兴趣是最好的老师，如果量子物理课", "confidence": 0.9990778800212976}, {"box": [[111.0, 834.0], [723.0, 846.0], [722.0, 868.0], [110.0, 856.0]], "text": "程能激发和保持学生的兴趣，将有助于他们克服学习量子力学的困难。", "confidence": 0.9995345165652614}, {"box": [[150.0, 864.0], [759.0, 875.0], [758.0, 899.0], [149.0, 887.0]], "text": "对于多数需要懂点量子物理的人（包括实验物理工作者、电子学工程", "confidence": 0.9979187945524851}, {"box": [[110.0, 893.0], [759.0, 907.0], [758.0, 929.0], [109.0, 916.0]], "text": "师和化学家）来说，需要的只是量子力学的基本概念和架构，而那套用微分", "confidence": 0.9942943724718961}, {"box": [[109.0, 923.0], [757.0, 936.0], [756.0, 958.0], [108.0, 945.0]], "text": "方程处理问题的方法并不真正用得着。能否绕过传统的那套以偏微分方程", "confidence": 0.9993534125387669}, {"box": [[110.0, 953.0], [757.0, 965.0], [756.0, 987.0], [109.0, 975.0]], "text": "为主线的量子力学教学体系，使量子力学的基本概念和架构能为低年级学", "confidence": 0.9994976371526718}, {"box": [[108.0, 981.0], [757.0, 994.0], [756.0, 1018.0], [107.0, 1004.0]], "text": "生所接受？20世纪60年代物理大师费曼迈出了第一步，《费曼物理学讲", "confidence": 0.9982990062598026}, {"box": [[139.0, 1048.0], [757.0, 1059.0], [756.0, 1082.0], [138.0, 1071.0]], "text": "①应该说，狄拉克的《量子力学》（1930年第一版，1956第四版）是用符号方法代", "confidence": 0.9819447144865989}, {"box": [[106.0, 1072.0], [756.0, 1085.0], [755.0, 1108.0], [105.0, 1095.0]], "text": "替偏微分方程来阐述量子力学原理的第一本教材。不过那本书不是为初学者写的，但我", "confidence": 0.9975024132352126}, {"box": [[107.0, 1098.0], [326.0, 1103.0], [326.0, 1124.0], [106.0, 1118.0]], "text": "们还是从中吸取了不少营养。", "confidence": 0.9996586396143987}]