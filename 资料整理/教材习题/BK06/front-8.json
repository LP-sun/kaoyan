[{"box": [[135.0, 74.0], [156.0, 74.0], [156.0, 95.0], [135.0, 95.0]], "text": "IV", "confidence": 0.9189184606075287}, {"box": [[442.0, 73.0], [464.0, 73.0], [464.0, 94.0], [442.0, 94.0]], "text": "序", "confidence": 0.9943318367004395}, {"box": [[131.0, 125.0], [521.0, 123.0], [521.0, 143.0], [131.0, 145.0]], "text": "义》第三卷成了我们编写此书时的启蒙课本。", "confidence": 0.9995994389057159}, {"box": [[168.0, 153.0], [775.0, 151.0], [775.0, 172.0], [168.0, 174.0]], "text": "费曼胆识过人之处，在于他敢于把传统的量子力学教学顺序倒过来。他", "confidence": 0.9990052427014997}, {"box": [[129.0, 184.0], [776.0, 181.0], [776.0, 202.0], [129.0, 204.0]], "text": "一开头就介绍量子力学最基本、最普遍的特征，从概率幅和量子态的概念切", "confidence": 0.9986633098486698}, {"box": [[129.0, 213.0], [776.0, 211.0], [776.0, 231.0], [129.0, 233.0]], "text": "入，讲它们的叠加、分解和干涉，并用非常普遍但有点抽象的狄拉克符号来", "confidence": 0.9974126255873478}, {"box": [[128.0, 242.0], [776.0, 241.0], [776.0, 261.0], [128.0, 262.0]], "text": "描述它们。他从矩阵代数入手，代替通常的微分方程体系。对于从中学出来", "confidence": 0.9989103096904177}, {"box": [[130.0, 271.0], [775.0, 271.0], [775.0, 291.0], [130.0, 291.0]], "text": "不久的学生来说，矩阵运算比偏微分方程容易多了。这样一来，自旋的概念", "confidence": 0.9963696364200476}, {"box": [[129.0, 302.0], [775.0, 302.0], [775.0, 321.0], [129.0, 321.0]], "text": "就可以从通常排在较后的地方提到前面，为进一步讨论双态系统提供重要", "confidence": 0.9992454499006271}, {"box": [[129.0, 330.0], [775.0, 331.0], [775.0, 351.0], [129.0, 350.0]], "text": "的实例。我们认为，费曼的书最精彩的地方是他引用了大量的双态系统。从", "confidence": 0.9992432178873004}, {"box": [[128.0, 359.0], [775.0, 360.0], [775.0, 380.0], [128.0, 379.0]], "text": "微分方程的体系看，最简单的量子系统是一维系统，但双态系统却是更简单", "confidence": 0.998887533491308}, {"box": [[128.0, 388.0], [775.0, 390.0], [775.0, 410.0], [128.0, 408.0]], "text": "的量子系统。处理这类系统用不着微分方程，但要用矩阵代数。从氨分子翻", "confidence": 0.9990983497012745}, {"box": [[128.0, 416.0], [776.0, 420.0], [776.0, 440.0], [128.0, 437.0]], "text": "转分裂到苯分子的共振能和染料分子的共轭双键，从氨分子钟到核磁共振，", "confidence": 0.9987786520611156}, {"box": [[128.0, 447.0], [774.0, 449.0], [774.0, 469.0], [128.0, 467.0]], "text": "费曼能够为双态系统找到那么多有趣而富有实际意义的例子，颇令我们惊", "confidence": 0.9976107534021139}, {"box": [[129.0, 476.0], [773.0, 478.0], [773.0, 498.0], [129.0, 496.0]], "text": "叹和折服。并非自然界本来就有许多现成的双态系统，而是费曼一反量子力", "confidence": 0.9977003950061221}, {"box": [[128.0, 505.0], [774.0, 508.0], [774.0, 528.0], [128.0, 525.0]], "text": "学教学顺序的常规。通常在量子力学中讲原子能级的顺序是从主量子数到", "confidence": 0.9990648962557316}, {"box": [[128.0, 535.0], [774.0, 538.0], [774.0, 558.0], [128.0, 556.0]], "text": "角量子数，再到磁量子数（塞曼分裂），从能级的精细结构到超精细结构；讲", "confidence": 0.9977839536526624}, {"box": [[127.0, 563.0], [775.0, 566.0], [775.0, 589.0], [127.0, 586.0]], "text": "分子能级的顺序是从电子能级到振动能级，然后再到转动能级。费曼却从级", "confidence": 0.9987508762966503}, {"box": [[127.0, 594.0], [773.0, 597.0], [773.0, 617.0], [127.0, 614.0]], "text": "差最小的能级（如氨分子特定的转动能级，或氢原子的塞曼分裂能级和超", "confidence": 0.9988247510045767}, {"box": [[126.0, 621.0], [775.0, 624.0], [775.0, 647.0], [126.0, 644.0]], "text": "精细结构能级）开始，然后再在以后章节里逐渐扩展到大级差的基本能级。", "confidence": 0.9887386524316036}, {"box": [[127.0, 650.0], [774.0, 655.0], [774.0, 678.0], [127.0, 674.0]], "text": "由于能级钜细有多个数量级之差，把一对级差细微的能级孤立出来研究就", "confidence": 0.9987069517374039}, {"box": [[127.0, 681.0], [771.0, 685.0], [771.0, 707.0], [127.0, 703.0]], "text": "成为可能。这便是费曼书中双态系统的由来。我们体会，从双态系统入手，一", "confidence": 0.9987946433179519}, {"box": [[126.0, 711.0], [773.0, 715.0], [773.0, 735.0], [126.0, 731.0]], "text": "方面可以使学生较早地建立起态矢空间和表象变换等概念，这些量子力学", "confidence": 0.9983052872121334}, {"box": [[125.0, 739.0], [773.0, 743.0], [773.0, 766.0], [125.0, 762.0]], "text": "的基本架构本来是很抽象的，在微分方程的体系中只能放在课程中比较靠", "confidence": 0.9995313864201307}, {"box": [[126.0, 770.0], [772.0, 775.0], [772.0, 795.0], [126.0, 791.0]], "text": "后的地方讲，有些量子力学的简明教程甚至略去不讲。但对于双态系统来", "confidence": 0.9984539076685905}, {"box": [[126.0, 800.0], [773.0, 804.0], [773.0, 824.0], [126.0, 820.0]], "text": "说，希尔伯特空间约化成二维，无论态基的变换还是本征值、本征矢的求得，", "confidence": 0.9965124428272247}, {"box": [[126.0, 829.0], [772.0, 833.0], [772.0, 854.0], [126.0, 850.0]], "text": "在数学上都没有什么困难。另一方面，从双态系统入手，可使学生在本课程", "confidence": 0.9987753412940286}, {"box": [[126.0, 858.0], [771.0, 863.0], [771.0, 883.0], [126.0, 878.0]], "text": "中尽早地接触到量子物理里激动人心的最新成果，有助于激发学生学习的", "confidence": 0.9988806340843439}, {"box": [[126.0, 888.0], [180.0, 888.0], [180.0, 910.0], [126.0, 910.0]], "text": "热情。", "confidence": 0.9996908108393351}, {"box": [[165.0, 918.0], [771.0, 922.0], [771.0, 943.0], [164.0, 939.0]], "text": "费曼的书远非完美无瑕。费曼坦率地承认，对于教本科生基础课，他是", "confidence": 0.9989090235002579}, {"box": [[123.0, 945.0], [772.0, 950.0], [772.0, 973.0], [123.0, 968.0]], "text": "没有经验的，他在加州理工学院唯一的这次为大学本科二年级学生的讲授", "confidence": 0.9997343644499779}, {"box": [[124.0, 974.0], [771.0, 979.0], [771.0, 1002.0], [124.0, 997.0]], "text": "并不理想。我们也感到，他这本书中许多地方教学上的处理大有可斟酌之", "confidence": 0.9978658501058817}, {"box": [[123.0, 1003.0], [771.0, 1009.0], [771.0, 1032.0], [123.0, 1027.0]], "text": "处。不仅如此，在我们较深入地钻研了他这本教材之后，发现其中科学性的", "confidence": 0.9989246346733787}, {"box": [[123.0, 1034.0], [771.0, 1039.0], [771.0, 1061.0], [123.0, 1056.0]], "text": "欠妥和失误之处，并不是个别的。总起来看，当然是瑕不掩瑜。但如果我们东", "confidence": 0.998325006050222}, {"box": [[124.0, 1065.0], [770.0, 1070.0], [770.0, 1090.0], [124.0, 1085.0]], "text": "施效攀，就会弄巧成拙，到头来自已吃苦头。所以我们为编写自己的这本教", "confidence": 0.969301675305222}, {"box": [[124.0, 1093.0], [771.0, 1098.0], [771.0, 1120.0], [124.0, 1115.0]], "text": "材，在借用费曼光辉思想的同时，花了很大的工夫进行了一番艰苦的再创", "confidence": 0.9961942285299301}]