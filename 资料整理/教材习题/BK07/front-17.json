[{"box": [[395.83331298828125, 219.1028289794922], [1142.708251953125, 212.75201416015625], [1142.708251953125, 258.2661437988281], [395.83331298828125, 264.616943359375]], "text": "第一章热学基本概念和物质聚集态", "confidence": 0.9982824683189392}, {"box": [[307.2916564941406, 301.6632995605469], [1294.7916259765625, 293.195556640625], [1294.7916259765625, 327.0665283203125], [307.2916564941406, 335.5342712402344]], "text": "我国古代传说，燧人氏钻木取火以化腥臊，奉为千古圣皇；古希腊神话，", "confidence": 0.9520039241760969}, {"box": [[243.74998474121094, 352.4697570800781], [1294.7916259765625, 346.11895751953125], [1294.7916259765625, 377.87298583984375], [243.74998474121094, 384.2237854003906]], "text": "普罗米修斯（Prometheus）盗天火开罪于主神而泽惠天下，崇为世间英雄。", "confidence": 0.9920576920634822}, {"box": [[242.7083282470703, 402.2177429199219], [1295.833251953125, 397.98388671875], [1295.833251953125, 429.7379150390625], [242.7083282470703, 433.9717712402344]], "text": "在古代各民族的语言里，“火”与“热”几乎是同义语。热学这一门科学起源", "confidence": 0.989698506453458}, {"box": [[243.74998474121094, 453.0242004394531], [1294.7916259765625, 449.8487854003906], [1294.7916259765625, 480.5443420410156], [243.74998474121094, 483.7197570800781]], "text": "于人类对于热与冷现象本质的追求。由于史前人类已经发明了火，我们可以", "confidence": 0.9983417337590997}, {"box": [[242.7083282470703, 500.6552429199219], [1294.7916259765625, 499.5967712402344], [1294.7916259765625, 531.350830078125], [242.7083282470703, 532.4093017578125]], "text": "想象到，追求热与冷现象本质的企图可能是人类最初对自然界法则的追求", "confidence": 0.9981308802962303}, {"box": [[241.66665649414062, 550.4031982421875], [327.08331298828125, 552.5201416015625], [326.0416564941406, 586.39111328125], [240.62498474121094, 584.274169921875]], "text": "之一。", "confidence": 0.9960165023803711}, {"box": [[308.33331298828125, 602.2681274414062], [1294.7916259765625, 602.2681274414062], [1294.7916259765625, 632.9636840820312], [308.33331298828125, 632.9636840820312]], "text": "热学中最核心的概念是“温度”，另一重要概念是“热量”。在科学史上", "confidence": 0.9932568054646254}, {"box": [[245.8333282470703, 652.01611328125], [1294.7916259765625, 652.01611328125], [1294.7916259765625, 682.711669921875], [245.8333282470703, 682.711669921875]], "text": "长期以来这些基本概念是混淆不清的，“但是一经辨别清楚，就使得科学得", "confidence": 0.9918945702639493}, {"box": [[242.7083282470703, 700.7056274414062], [1295.833251953125, 701.7640991210938], [1295.833251953125, 733.5181274414062], [242.7083282470703, 732.4596557617188]], "text": "到飞速的发展。”（爱因斯坦语）。的确，这些概念都是相当深刻的，在本课", "confidence": 0.9922429218011743}, {"box": [[243.74998474121094, 751.5120849609375], [1294.7916259765625, 753.6290283203125], [1294.7916259765625, 784.3245849609375], [243.74998474121094, 782.2076416015625]], "text": "里也不能一下子把问题说透彻。我们先对它们作些初步的介绍和分析，随着", "confidence": 0.9959483038295399}, {"box": [[243.74998474121094, 800.2015991210938], [1001.0416259765625, 803.3770141601562], [1001.0416259765625, 835.1310424804688], [243.74998474121094, 831.9556274414062]], "text": "课程的进展，读者将会对这些概念有逐步深人的理解。", "confidence": 0.9968501304586729}, {"box": [[677.0833129882812, 873.2359008789062], [869.7916259765625, 873.2359008789062], [869.7916259765625, 916.633056640625], [677.0833129882812, 916.633056640625]], "text": "81.温度", "confidence": 0.9586242198944092}, {"box": [[242.7083282470703, 958.9718017578125], [498.95831298828125, 962.1471557617188], [498.95831298828125, 994.9596557617188], [242.7083282470703, 991.7843017578125]], "text": "1.1温度计和温标", "confidence": 0.9970877236790128}, {"box": [[308.33331298828125, 1019.304443359375], [1294.7916259765625, 1022.4798583984375], [1294.7916259765625, 1054.23388671875], [308.33331298828125, 1051.0584716796875]], "text": "朴素的温度概念来自于日常生活，冷热的感觉靠身体触摸。南北朝贾思", "confidence": 0.9958790329194838}, {"box": [[243.74998474121094, 1066.935546875], [1293.75, 1072.227783203125], [1293.75, 1103.9818115234375], [243.74998474121094, 1098.6895751953125]], "text": "的《齐民要术》中谈：制酪的温度要“小暖于人体”，作豉则“令温如腋下", "confidence": 0.9737601099592267}, {"box": [[244.79165649414062, 1117.741943359375], [1295.833251953125, 1121.975830078125], [1295.83325