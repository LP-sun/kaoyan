[{"box": [[714.5833129882812, 221.21975708007812], [767.7083129882812, 221.21975708007812], [767.7083129882812, 270.9677429199219], [714.5833129882812, 270.9677429199219]], "text": "序", "confidence": 0.9977729916572571}, {"box": [[281.25, 352.4697570800781], [1264.583251953125, 350.3528137207031], [1264.583251953125, 382.1068420410156], [281.25, 384.2237854003906]], "text": "本书是《新概念物理教程》中继《力学》卷之后的第二卷，编写和改革", "confidence": 0.9987316939138597}, {"box": [[216.66665649414062, 404.3346862792969], [1264.583251953125, 403.2762145996094], [1264.583251953125, 431.8548278808594], [216.66665649414062, 432.9132995605469]], "text": "的思路是一脉相承的，但根据热学教学内容的特点有所发展和不尽相同的", "confidence": 0.9985893946141005}, {"box": [[216.66665649414062, 454.0826721191406], [572.9166259765625, 454.0826721191406], [572.9166259765625, 484.7782287597656], [216.66665649414062, 484.7782287597656]], "text": "侧重。现将要点分述如下。", "confidence": 0.9764110893011093}, {"box": [[215.62498474121094, 502.7721862792969], [882.2916259765625, 503.8306579589844], [882.2916259765625, 535.5846557617188], [215.62498474121094, 534.5261840820312]], "text": "、按照科学发展的进程和需求，强化的教学", "confidence": 0.9956833469240289}, {"box": [[280.20831298828125, 551.461669921875], [1264.583251953125, 554.6370849609375], [1264.583251953125, 586.39111328125], [280.20831298828125, 583.2156982421875]], "text": "热力学第一定律和热力学第二定律从来就是热学中最基本的两条定", "confidence": 0.9989878987443859}, {"box": [[213.54165649414062, 602.2681274414062], [1264.583251953125, 605.4435424804688], [1264.583251953125, 637.1975708007812], [213.54165649414062, 634.0221557617188]], "text": "律，前者是能量的规律，后者是熵的法则。“能”和“熵”两个概念哪个更为", "confidence": 0.9866331675473381}, {"box": [[214.5833282470703, 652.01611328125], [1264.583251953125, 656.25], [1264.583251953125, 686.945556640625], [214.5833282470703, 682.711669921875]], "text": "重要？随着时间的推移，情况正在变化。传统的看法以为“能”是宇宙的女", "confidence": 0.9962184754284945}, {"box": [[215.62498474121094, 702.8225708007812], [1263.5416259765625, 707.0564575195312], [1263.5416259765625, 737.7520141601562], [215.62498474121094, 733.5181274414062]], "text": "主人，“熵”是她的影子。后来有人提出不同的看法：“在自然过程的庞大工", "confidence": 0.9796418442445642}, {"box": [[214.5833282470703, 751.5120849609375], [1262.5, 757.8629150390625], [1262.5, 788.5584716796875], [214.5833282470703, 782.2076416015625]], "text": "厂里，熵原理起着经理的作用，因为它规定整个企业的经营方式和方法，而", "confidence": 0.9883951996311997}, {"box": [[214.5833282470703, 801.2600708007812], [1079.1666259765625, 806.5524291992188], [1079.1666259765625, 838.3064575195312], [214.5833282470703, 833.0140991210938]], "text": "能原理仅仅充当簿记，平衡贷方和借方。”（1938R.Emden语）", "confidence": 0.9858697454134623}, {"box": [[280.20831298828125, 852.0665283203125], [1262.5, 858.4173583984375], [1262.5, 890.17138671875], [280.20831298828125, 883.820556640625]], "text": "热力学定律和达尔文的进化论同属19世纪科学上最伟大的发现，然而", "confidence": 0.9967097236264136}, {"box": [[213.54165649414062, 901.8145141601562], [1262.5, 909.2238159179688], [1262.5, 940.9778442382812], [213.54165649414062, 933.5685424804688]], "text": "表面上看起来二者似乎相互抵触。本世纪40年代薛定谔提出了生命“赖负", "confidence": 0.9932917085560885}, {"box": [[213.54165649414062, 1003.4274291992188], [1260.4166259765625, 1010.836669921875], [1260.4166259765625, 1042.5906982421875], [213.54165649414062, 1035.181396484375]], "text": "学第二定律与进化论的矛盾被澄清了。从物理学走向生命科学，越发显示出", "confidence": 0.999035920157577}, {"box": [[210.41665649414062, 1050.0], [579.1666259765625, 1055.2923583984375], [579.1666259765625, 1090.2218017578125], [210.41665649414062, 1084.929443359375]], "text": "“熵”这个概念的重要性。", "confidence": 0.9822681893905004}, {"box": [[276.0416564941406, 1101.8648681640625], [1260.4166259765625, 1111.39111328125], [1260.4166259765625, 1143.1451416015625], [276.0416564941406, 1133.618896484375]], "text": "1948年电气工程师香农（C.E.Shannon）创立了信息论，将信息量与负", "confidence": 0.9974552189048967}, {"box": [[213.54165649414062, 1152.67138671875], [1262.5, 1161.13916015625], [1262.5, 1192.8931884765625], [213.54165649414062, 1184.4254150390625]], "text": "熵联系起来。历史上以热机发展为主导的第一次工业革命是能量的革命，当", "confidence": 0.9778643431085529}, {"box": [[213.54165649414062, 1202.4193115234375], [1262.5, 1210.8870849609375], [1262.5, 1242.64111328125], [213.54165649414062, 1234.17333984375]], "text": "前以信息技术为主导的第二次工业革命可以说是熵的革命。现在“熵”这个", "confidence": 0.9903038649848013}, {"box": [[213.54165649414062, 1252.1673583984375], [1007.2916259765625, 1259.57666015625], [1007.2916259765625, 1291.3306884765625], [213.54165649414062, 1283.92138671875]], "text": "名词已超出自然科学和工程技术的领域，进入人文科学。", "confidence": 0.9967948842048645}, {"box": [[276.0416564941406, 1304.0322265625], [1261.458251953125, 1311.4415283203125], [1261.458251953125, 1343.195556640625], [276.0416564941406, 1335.7862548828125]], "text": "近年来国际上一些物理教育改革家企图把物理学归结为少数几个基本", "confidence": 0.999142861366272}, {"box": [[212.49998474121094, 1354.8387451171875], [1261.458251953125, 1363.306396484375], [1261.458251953125, 1395.060546875], [212.49998474121094, 1386.5927734375]], "text": "概念，尽管各家之言见仁见智，但无例外地都把“熵”（或其等价的说法，如", "confidence": 0.9830206369652468}, {"box": [[211.4583282470703, 1404.586669921875], [1260.4166259765625, 1414.1129150390625], [1260.4166259765625, 1445.866943359375], [211.4583282470703, 1436.3406982421875]], "text": "能的退降）列为一条。但在传统的普物教材中“熵”介绍得很简略，有些为", "confidence": 0.973003294431802}, {"box": [[211.4583282470703, 1455.3931884765625], [1261.458251953125, 1464.9193115234375], [1261.458251953125, 1496.67333984375], [211.4583282470703, 1487.147216796875]], "text": "非物理专业开设的课程中“熵”已被删除。这是违反科技进步发展的时代潮", "confidence": 0.9900018572807312}, {"box": [[210.41665649414062, 1505.14111328125], [1260.4166259765625, 1515.725830078125], [1260.4166259765625, 1547.4798583984375], [210.41665649414062, 1536.8951416015625]], "text": "流的。在本书中我们从微观（玻耳兹曼熵）到宏观（克劳修斯熵），从历史到", "confidence": 0.9734939459492179}, {"box": [[211.4583282470703, 1555.9476318359375], [1261.458251953125, 1565.4737548828125], [1261.458251953125, 1597.227783203125], [211.4583282470703, 1587.70166015625]], "text": "前沿，从物理学到化学、环境与生命科学，多方面地介绍了“熵”的概念。特", "confidence": 0.9905199987046859}, {"box": [[211.4583282470703, 1605.695556640625], [1260.4166259765625, 1616.2802734375], [1260.4166259765625, 1646.975830078125], [211.4583282470703, 1636.39111328125]], "text": "别是我们认为，只有通过应用才能加深对一个概念的理解。热力学第二定律", "confidence": 0.9992300958344431}, {"box": [[211.4583282470703, 1655.443603515625], [1257.2916259765625, 1667.086669921875], [1257.2916259765625, 1698.8406982421875], [211.4583282470703, 1687.1976318359375]], "text": "的正宗应用是讨论热平衡的条件和判据。因为最常见的系统不是孤立系，而", "confidence": 0.9986538868961912}, {"box": [[208.3333282470703, 1703.0745849609375], [1259.375, 1715.7762451171875], [1259.375, 1750.7056884765625], [208.3333282470703, 1738.0040283203125]], "text": "是在一定外部约束条件下（如定温、定体或定压）的热力学系统，我们还需", "confidence": 0.9904919375072826}, {"box": [[209.37498474121094, 1755.998046875], [1257.2916259765625, 1767.64111328125], [1257.2916259765625, 1799.3951416015625], [209.37498474121094, 1787.7520751953125]], "text": "把“熵”的概念延伸到“自由能”的概念才好应用。讲熵而不讲自由能，实属", "confidence": 0.9766520016333636}, {"box": [[208.3333282470703, 1806.804443359375], [1257.2916259765625, 1817.38916015625], [1257.2916259765625, 1849.1431884765625], [208.3333282470703, 1838.5584716796875]], "text": "功亏一簧。引入“自由能”并运用到热平衡问题上，可使学生反过来加深对", "confidence": 0.9883933862050375}, {"box": [[205.2083282470703, 1854.435546875], [1256.25, 1868.195556640625], [1256.25, 1903.125], [205.2083282470703, 1889.3648681640625]], "text": "“熵”概念的理解，在这一点上本书的两位作者各自都曾有过一些教学实", "confidence": 0.9840586688369513}]