[{"box": [[759.375, 117.48992156982422], [800.0, 117.48992156982422], [800.0, 153.4778289794922], [759.375, 153.4778289794922]], "text": "序", "confidence": 0.9991735816001892}, {"box": [[1266.6666259765625, 121.72379302978516], [1293.75, 121.72379302978516], [1293.75, 151.3608856201172], [1266.6666259765625, 151.3608856201172]], "text": "厦", "confidence": 0.6817092895507812}, {"box": [[249.99998474121094, 205.34274291992188], [313.5416564941406, 205.34274291992188], [313.5416564941406, 241.3306427001953], [249.99998474121094, 241.3306427001953]], "text": "践。", "confidence": 0.9998399317264557}, {"box": [[317.70831298828125, 258.2661437988281], [1298.958251953125, 258.2661437988281], [1298.958251953125, 288.9617004394531], [317.70831298828125, 288.9617004394531]], "text": "有所取就要有所舍。过去在普物的热学课中常常热衷于讨论热机或一", "confidence": 0.9960810343424479}, {"box": [[251.04165649414062, 308.01409912109375], [1301.0416259765625, 310.13104248046875], [1301.0416259765625, 340.82659912109375], [251.04165649414062, 338.7096862792969]], "text": "般循环的效率问题。近年来国内外物理教育界有识之士都认识到，循环效率", "confidence": 0.9986427841764508}, {"box": [[251.04165649414062, 356.7036437988281], [1300.0, 359.8790283203125], [1300.0, 391.633056640625], [251.04165649414062, 388.4576721191406]], "text": "问题不过是引入定理的-一根拐杖，它本身早已不该是物理课程的重点。最", "confidence": 0.9941317132025054}, {"box": [[248.9583282470703, 407.51007080078125], [1300.0, 410.68548583984375], [1300.0, 442.43951416015625], [248.9583282470703, 439.2641296386719]], "text": "好能想办法绕过它，至少需要淡化它。本书（特别是在习题中）不再对各式", "confidence": 0.9982023040453593}, {"box": [[248.9583282470703, 457.258056640625], [692.7083129882812, 461.491943359375], [692.7083129882812, 492.1875], [248.9583282470703, 487.9536437988281]], "text": "各样循环的效率作过多的讨论。", "confidence": 0.999393173626491}, {"box": [[249.99998474121094, 507.00604248046875], [1211.458251953125, 512.2984008789062], [1211.458251953125, 542.9939575195312], [249.99998474121094, 537.7015991210938]], "text": "二、运用定性半定量的方法，以普通物理的风格引进量子统计的概念", "confidence": 0.995106961329778}, {"box": [[314.58331298828125, 555.695556640625], [1297.9166259765625, 564.163330078125], [1297.9166259765625, 595.9173583984375], [314.58331298828125, 587.4495849609375]], "text": "从提出“普通物理现代化”的那天起，“现代物理普物化”的问题就提", "confidence": 0.9973187388912323}, {"box": [[249.99998474121094, 604.3850708007812], [1297.9166259765625, 613.9113159179688], [1297.9166259765625, 645.6653442382812], [249.99998474121094, 636.1390991210938]], "text": "上了教改的日程。现代物理硕果累累，琳琅满目，教师领着学生浏览一下，固", "confidence": 0.996155568782021}, {"box": [[248.9583282470703, 654.133056640625], [1296.875, 663.6593017578125], [1296.875, 695.413330078125], [248.9583282470703, 685.8870849609375]], "text": "然对开阔他们的眼界，提高他们学物理的积极性不无好处。然而，作为一门", "confidence": 0.9991843122424502}, {"box": [[248.9583282470703, 704.9395141601562], [1297.9166259765625, 714.4656982421875], [1297.9166259765625, 746.2197875976562], [248.9583282470703, 736.6935424804688]], "text": "物理课，重要的是让学生对这些成就的物理本质有起码的了解，这就涉及近", "confidence": 0.9986363017197811}, {"box": [[246.87498474121094, 754.6875], [1296.875, 765.2721557617188], [1296.875, 797.0261840820312], [246.87498474121094, 786.4415283203125]], "text": "代物理的理论基础一一相对论和量子力学了。“现代物理普物化”的标志", "confidence": 0.9786503668874502}, {"box": [[245.8333282470703, 805.4939575195312], [858.3333129882812, 812.9031982421875], [858.3333129882812, 843.5988159179688], [245.8333282470703, 836.1895141601562]], "text": "是用普物的风格讲好相对论和量子力学。", "confidence": 0.9994971652825674}, {"box": [[311.45831298828125, 856.3004150390625], [1294.7916259765625, 866.8850708007812], [1294.7916259765625, 898.6390991210938], [311.45831298828125, 888.054443359375]], "text": "所谓“普物风格”，我们的理解是讲授尽量避免艰深和复杂的数学，突", "confidence": 0.9964056611061096}, {"box": [[247.91665649414062, 906.0484008789062], [1294.7916259765625, 918.75], [1294.7916259765625, 949.445556640625], [247.91665649414062, 936.7439575195312]], "text": "出物理本质，树立鲜明的物理图像。我们在《新概念力学》里，继狭义相对论", "confidence": 0.9974024523706997}, {"box": [[246.87498474121094, 955.79638671875], [1294.7916259765625, 968.4979858398438], [1294.7916259765625, 1000.2520141601562], [246.87498474121094, 987.5504150390625]], "text": "之后，从等效原理出发介绍了广义相对论的一些基本内容，避免了黎曼几何", "confidence": 0.9970730218020353}, {"box": [[246.87498474121094, 1006.6028442382812], [1293.75, 1018.2459716796875], [1293.75, 1050.0], [246.87498474121094, 1038.3568115234375]], "text": "与时空度规等数学语言。本卷《热学》遇到的是量子统计问题。实现这个问", "confidence": 0.9895963614637201}, {"box": [[244.79165649414062, 1055.2923583984375], [1244.7916259765625, 1067.993896484375], [1244.7916259765625, 1099.748046875], [244.79165649414062, 1087.04638671875]], "text": "题的普物化是有相当难度的，经过几次修改，我们现在的处理方案如下。", "confidence": 0.9981383234262466}, {"box": [[311.45831298828125, 1107.1572265625], [1292.708251953125, 1117.741943359375], [1292.708251953125, 1149.4959716796875], [311.45831298828125, 1138.9112548828125]], "text": "只讨论理想气体。简并理想气体的量子性主要体现在能级的离散性和", "confidence": 0.9988779425621033}, {"box": [[244.79165649414062, 1155.8468017578125], [1293.75, 1167.4898681640625], [1293.75, 1199.243896484375], [244.79165649414062, 1187.600830078125]], "text": "粒子之间的量子关联上。学生对前者并不太难接受，我们反而可以利用离散", "confidence": 0.9938241333672495}, {"box": [[243.74998474121094, 1205.5947265625], [1293.75, 1218.29638671875], [1293.75, 1250.0504150390625], [243.74998474121094, 1237.3487548828125]], "text": "性把复杂的多重积分化为求和，在无需求出计算结果的情况下，求和表达式", "confidence": 0.9983075586232272}, {"box": [[242.7083282470703, 1254.2843017578125], [1292.708251953125, 1268.0443115234375], [1292.708251953125, 1302.9737548828125], [242.7083282470703, 1289.2137451171875]], "text": "的简洁性对突出物理本质是有利的。因而我们利用了离散形式的玻耳兹曼", "confidence": 0.9977909792214632}, {"box": [[241.66665649414062, 1305.0906982421875], [1292.708251953125, 1318.850830078125], [1292.708251953125, 1353.7802734375], [241.66665649414062, 1340.0201416015625]], "text": "动理方程导出理想气体的MB、BE、FD三种统计分布和H定理来，突出体现", "confidence": 0.9904187491961888}, {"box": [[243.74998474121094, 1355.897216796875], [1292.708251953125, 1369.6572265625], [1292.708251953125, 1404.586669921875], [243.74998474121094, 1390.82666015625]], "text": "了它们是粒子在不断碰撞（跃迁）的过程中达到的动态平衡。粒子间的量子", "confidence": 0.9951205578717318}, {"box": [[240.62498474121094, 1407.7620849609375], [1291.6666259765625, 1420.4637451171875], [1291.6666259765625, 1452.2177734375], [240.62498474121094, 1439.51611328125]], "text": "关联影响着跃迁的概率，从而决定着统计分布的具体形式。这只能通过比喻", "confidence": 0.9977739995176141}, {"box": [[239.5833282470703, 1457.5101318359375], [489.58331298828125, 1461.743896484375], [489.58331298828125, 1493.498046875], [239.5833282470703, 1489.26416015625]], "text": "让学生去理解了。", "confidence": 0.9997288286685944}, {"box": [[304.1666564941406, 1507.258056640625], [1289.583251953125, 1521.0181884765625], [1289.583251953125, 1555.9476318359375], [304.1666564941406, 1542.1875]], "text": "导出了统计分布函数，是讨论物理问题的开始，而不是终结。量子理想", "confidence": 0.9875444885223142}, {"box": [[241.66665649414062, 1555.9476318359375], [1289.583251953125, 1570.76611328125], [1289.583251953125, 1604.6370849609375], [241.66665649414062, 1589.818603515625]], "text": "气体有别于经典理想气体的崭新特征，是它们的简并性强烈地依赖于它们", "confidence": 0.9930731561034918}, {"box": [[239.5833282470703, 1604.6370849609375], [1289.583251953125, 1619.4556884765625], [1289.583251953125, 1654.3851318359375], [239.5833282470703, 1639.5665283203125]], "text": "的密度。找出描述量子气体简并性的参量（如费米能、简并温度和简并压)", "confidence": 0.974700001153079}, {"box": [[239.5833282470703, 1655.443603515625], [1288.5416259765625, 1670.2620849609375], [1288.5416259765625, 1705.1915283203125], [239.5833282470703, 1690.373046875]], "text": "与密度的函数关系，在将理论应用到实际问题时是十分必要的。反映这种函", "confidence": 0.9959025527491714}, {"box": [[235.41665649414062, 1706.25], [1288.5416259765625, 1722.1270751953125], [1288.5416259765625, 1757.0565185546875], [235.41665649414062, 1741.179443359375]], "text": "数关系的信息本来已包含在统计分布的表达式中，在理论物理课程中只需", "confidence": 0.9957878869026899}, {"box": [[233.3333282470703, 1755.998046875], [1287.5, 1771.875], [1287.5, 1806.804443359375], [233.3333282470703, 1790.9273681640625]], "text": "做进一步的数学推演即可。但普物风格的讲法不宜这样处理。我们从海森伯", "confidence": 0.9993563276348691}, {"box": [[234.37498474121094, 1807.8629150390625], [1286.458251953125, 1824.79833984375], [1286.458251953125, 1858.6693115234375], [234.37498474121094, 1841.73388671875]], "text": "不确定度关系出发，采用了定性和半定量的方法，导出了简并温度依赖密度", "confidence": 0.9976883259686556}, {"box": [[235.41665649414062, 1857.61083984375], [1289.583251953125, 1873.4879150390625], [1289.583251953125, 1908.4173583984375], [235.41665649414062, 1892.540283203125]], "text": "的函数关系，最后只剩下一个无量纲的数值系数不能准确确定。如前所述，", "confidence": 0.9867943579500372}]