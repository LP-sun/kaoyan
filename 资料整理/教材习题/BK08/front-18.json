[{"box": [[217.0, 107.0], [507.0, 108.0], [507.0, 129.0], [217.0, 128.0]], "text": "第一章实验基础与基本原理", "confidence": 0.9999156345923742}, {"box": [[146.0, 145.0], [612.0, 145.0], [612.0, 163.0], [146.0, 163.0]], "text": "本章是全书开宗明义第一章，如果说全书将带领读者到量子王国去游", "confidence": 0.9990256289641063}, {"box": [[110.0, 167.0], [614.0, 167.0], [614.0, 185.0], [110.0, 185.0]], "text": "览的话，本章是一张导游图。量子王国地处微观世界，那里的一切对于我们", "confidence": 0.999424159526825}, {"box": [[110.0, 190.0], [614.0, 190.0], [614.0, 208.0], [110.0, 208.0]], "text": "这些生活在宏观世界的人是那样的陌生，理解那里的“语言”、“法制”和“风", "confidence": 0.9876131364277431}, {"box": [[110.0, 212.0], [614.0, 212.0], [614.0, 230.0], [110.0, 230.0]], "text": "土人情”是相当困难的。我们必须“人邦问俗”，最好先粗通量子物理的术语", "confidence": 0.9902111326946932}, {"box": [[111.0, 233.0], [529.0, 235.0], [529.0, 253.0], [110.0, 251.0]], "text": "和理论架构，再进人各个具体问题的讨论时，会感到主动一些。", "confidence": 0.9935158256973539}, {"box": [[141.0, 257.0], [612.0, 257.0], [612.0, 272.0], [141.0, 272.0]], "text": "本章的前两节介绍量子论的实验基础。这些实验表明，经典物理中一些", "confidence": 0.9996413800024218}, {"box": [[110.0, 301.0], [614.0, 301.0], [614.0, 319.0], [110.0, 319.0]], "text": "“粒子”。于是有人猜测，电子是公认的粒子，会不会也有“波动性”？果真被", "confidence": 0.9895420755658831}, {"box": [[109.0, 344.0], [614.0, 343.0], [614.0, 362.0], [109.0, 363.0]], "text": "到荒诞和神秘）的概念，导致了量子力学的建立。从本章3起我们逐步引", "confidence": 0.9995068199932575}, {"box": [[111.0, 368.0], [371.0, 368.0], [371.0, 384.0], [111.0, 384.0]], "text": "入量子力学最基本的概念和理论架构。", "confidence": 0.9893611248801736}, {"box": [[142.0, 389.0], [613.0, 389.0], [613.0, 407.0], [142.0, 407.0]], "text": "在经典物理中物理量具有确定的量值，服从一定的规律。而量子力学中", "confidence": 0.9968669895202883}, {"box": [[110.0, 413.0], [613.0, 413.0], [613.0, 431.0], [110.0, 431.0]], "text": "物理量（称为“动力学变量”）却是“态矢空间”里的“算符”，一般说来，一个", "confidence": 0.9842673208978441}, {"box": [[110.0, 437.0], [614.0, 437.0], [614.0, 455.0], [110.0, 455.0]], "text": "动力学变量有多个“本征值”，测量它们时并不得到确定的量值，而是以一定", "confidence": 0.9972383099443772}, {"box": [[110.0, 483.0], [615.0, 482.0], [615.0, 501.0], [110.0, 502.0]], "text": "数，它的模方才是概率。概率幅具有模量和相角，叠加时可以产生干涉。够", "confidence": 0.9986961935505723}, {"box": [[111.0, 507.0], [614.0, 506.0], [614.0, 525.0], [111.0, 526.0]], "text": "了，这些名词和概念已经是经典物理中闻所未闻、见所未见的，且不说其它", "confidence": 0.9984684694897045}, {"box": [[113.0, 555.0], [615.0, 554.0], [615.0, 573.0], [113.0, 574.0]], "text": "4～6引入“算符”的概念，S7引人“态矢”和“态矢空间”的概念。在本章", "confidence": 0.9450275574411665}, {"box": [[112.0, 578.0], [615.0, 576.0], [615.0, 595.0], [112.0, 597.0]], "text": "8～10中介绍一些后面几章将用到的概念之后，最后在11里为本章", "confidence": 0.9951713469720656}, {"box": [[110.0, 602.0], [614.0, 602.0], [614.0, 620.0], [110.0, 620.0]], "text": "学到的量子力学基本原理做一个小结。这样，我们就取得了进入后面各章的", "confidence": 0.991059725934809}, {"box": [[111.0, 627.0], [185.0, 627.0], [185.0, 643.0], [111.0, 643.0]], "text": "“人场券”。", "confidence": 0.9282999535401663}, {"box": [[215.0, 660.0], [512.0, 658.0], [512.0, 680.0], [215.0, 682.0]], "text": "81.热辐射与普朗克的量子假说", "confidence": 0.9815751353899638}, {"box": [[111.0, 711.0], [344.0, 711.0], [344.0, 727.0], [111.0, 727.0]], "text": "1.1一般特征与辐射场的定量描述", "confidence": 0.999552208930254}, {"box": [[140.0, 737.0], [615.0, 737.0], [615.0, 755.0], [140.0, 755.0]], "text": "把铁条插在炉火中，它会被烧得通红。起初在温度不太高时，我们看不", "confidence": 0.9994724988937378}, {"box": [[111.0, 761.0], [615.0, 761.0], [615.0, 779.0], [111.0, 779.0]], "text": "到它发光，却可感到它辐射出来的热量。当温度达到500°C左右时，铁条开", "confidence": 0.9907946382250105}, {"box": [[111.0, 785.0], [615.0, 785.0], [615.0, 803.0], [111.0, 803.0]], "text": "始发出可见的光辉。随着温度的升高，不但光的强度逐渐增大，颜色也由暗", "confidence": 0.9986554041053309}, {"box": [[110.0, 808.0], [615.0, 808.0], [615.0, 827.0], [110.0, 827.0]], "text": "红转为橙红。以上是我们日常生活中熟知的现象，它们反映了热辐射的一般", "confidence": 0.9992185379519607}, {"box": [[110.0, 832.0], [615.0, 832.0], [615.0, 850.0], [110.0, 850.0]], "text": "特征，即随着温度的升高，(1)辐射的总功率增大；(2)强度在光谱中的分布", "confidence": 0.9693496343162324}, {"box": [[111.0, 856.0], [615.0, 856.0], [615.0, 874.0], [111.0, 874.0]], "text": "由长波向短波转移。热辐射不一定需要高温，实际上，任何温度（室温或更", "confidence": 0.9973062782576589}, {"box": [[111.0, 880.0], [615.0, 880.0], [615.0, 898.0], [111.0, 898.0]], "text": "低）的物体都发出一定的热辐射，只不过在低温下辐射不强，且其中包含的", "confidence": 0.9996225183660333}]