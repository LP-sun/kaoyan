[{"box": [[246.0, 57.0], [415.0, 57.0], [415.0, 73.0], [246.0, 73.0]], "text": "第一章实验基础与基本原理", "confidence": 0.9998500396807989}, {"box": [[79.0, 95.0], [583.0, 96.0], [583.0, 115.0], [79.0, 114.0]], "text": "主要是波长较长的红外线。用红外夜视仪侦查军事目标，就是利用了这个原", "confidence": 0.9997196197509766}, {"box": [[79.0, 121.0], [107.0, 121.0], [107.0, 138.0], [79.0, 138.0]], "text": "理。", "confidence": 0.9999801516532898}, {"box": [[110.0, 145.0], [582.0, 145.0], [582.0, 163.0], [110.0, 163.0]], "text": "按照热力学原理，热量从高温物体自发地流向低温物体。热量传递的方", "confidence": 0.9989727600928275}, {"box": [[79.0, 168.0], [582.0, 168.0], [582.0, 186.0], [79.0, 186.0]], "text": "式有多种，热辐射是其中的一种。在物体和物体之间的空间里总存在着一定", "confidence": 0.9996562654321844}, {"box": [[78.0, 191.0], [582.0, 192.0], [582.0, 211.0], [78.0, 210.0]], "text": "的辐射场，即各种频率的电磁波。每个物体通过发射和吸收的过程与周围的", "confidence": 0.9995228612061703}, {"box": [[79.0, 217.0], [582.0, 217.0], [582.0, 235.0], [79.0, 235.0]], "text": "辐射场交换能量。在非平衡态下，温度较高的物体失多于得，温度较低的物", "confidence": 0.9996989965438843}, {"box": [[80.0, 240.0], [459.0, 240.0], [459.0, 258.0], [80.0, 258.0]], "text": "体得大于失，能量便这样通过辐射场由前者传递给后者。", "confidence": 0.9991530776023865}, {"box": [[110.0, 264.0], [583.0, 264.0], [583.0, 282.0], [110.0, 282.0]], "text": "为了定量地描述辐射场和它与物体间发生的各种能量转移过程，下面", "confidence": 0.9996752758820852}, {"box": [[79.0, 288.0], [582.0, 288.0], [582.0, 306.0], [79.0, 306.0]], "text": "我们将引人一系列物理量。辐射场中包含各种频率和沿各个方向传播的电", "confidence": 0.9979184605181217}, {"box": [[79.0, 311.0], [583.0, 312.0], [583.0, 331.0], [79.0, 330.0]], "text": "磁波。最细致地描述辐射场，需要用一个辐射能的分布函数f(v，k，r，t)，", "confidence": 0.9778976569304595}, {"box": [[78.0, 335.0], [583.0, 336.0], [583.0, 355.0], [78.0, 354.0]], "text": "其中k代表沿传播方向的单位矢量，r是空间场点的位矢，t是时间。这函", "confidence": 0.99064194614237}, {"box": [[79.0, 360.0], [582.0, 360.0], [582.0, 379.0], [79.0, 379.0]], "text": "数的物理意义如下：在t时刻、空间r点附近单位体积内的辐射场中，分布", "confidence": 0.9920143683751425}, {"box": [[79.0, 383.0], [583.0, 383.0], [583.0, 401.0], [79.0, 401.0]], "text": "在①以v为中心的频段dv内，②以k方向为轴的立体角元d2内的能量", "confidence": 0.974217027425766}, {"box": [[80.0, 408.0], [98.0, 408.0], [98.0, 425.0], [80.0, 425.0]], "text": "为", "confidence": 0.9999998807907104}, {"box": [[261.0, 421.0], [399.0, 421.0], [399.0, 443.0], [261.0, 443.0]], "text": "f(v,k,r,t)dvdΩ.", "confidence": 0.8258632918198904}, {"box": [[544.0, 425.0], [583.0, 425.0], [583.0, 441.0], [544.0, 441.0]], "text": "(1.1)", "confidence": 0.9986165881156921}, {"box": [[79.0, 446.0], [583.0, 447.0], [583.0, 466.0], [79.0, 465.0]], "text": "若辐射场是均匀的，f与r无关；若辐射场是恒定的，f与t无关；若辐射场", "confidence": 0.9931765654507805}, {"box": [[79.0, 472.0], [285.0, 469.0], [286.0, 488.0], [79.0, 491.0]], "text": "是各向同性的，f与k无关。·", "confidence": 0.9431898423603603}, {"box": [[111.0, 495.0], [582.0, 495.0], [582.0, 513.0], [111.0, 513.0]], "text": "利用分布函数f可导出许多物理量，它们各自以不同的细致程度描述", "confidence": 0.9983793497085571}, {"box": [[81.0, 519.0], [458.0, 519.0], [458.0, 537.0], [81.0, 537.0]], "text": "着辐射场某些方面的性质。描述辐射场本身的物理量有：", "confidence": 0.999854769706726}, {"box": [[111.0, 543.0], [570.0, 543.0], [570.0, 561.0], [111.0, 561.0]], "text": "(1）辐射场的能量密度U(单位体积内的辐射能）及其谱密度u(v)：", "confidence": 0.9581915537516276}, {"box": [[186.0, 572.0], [369.0, 572.0], [369.0, 597.0], [186.0, 597.0]], "text": "U(r,t)=u（v,r,t)dv,", "confidence": 0.8110612564616733}, {"box": [[544.0, 576.0], [583.0, 576.0], [583.0, 594.0], [544.0, 594.0]], "text": "(1.2)", "confidence": 0.9985629081726074}, {"box": [[185.0, 609.0], [420.0, 609.0], [420.0, 633.0], [185.0, 633.0]], "text": "u(v,r,t)=f(v,k,r,t)do", "confidence": 0.807907583458083}, {"box": [[188.0, 646.0], [272.0, 646.0], [272.0, 665.0], [188.0, 665.0]], "text": "取球坐标2", "confidence": 0.9953804612159729}, {"box": [[252.0, 647.0], [483.0, 645.0], [483.0, 679.0], [252.0, 681.0]], "text": "do Jdo sine f(v,0,p,r,t)", "confidence": 0.8832341842353344}, {"box": [[543.0, 657.0], [583.0, 657.0], [583.0, 674.0], [543.0, 674.0]], "text": "(1.3)", "confidence": 0.9989137649536133}, {"box": [[185.0, 690.0], [424.0, 690.0], [424.0, 709.0], [185.0, 709.0]], "text": "=4πf(v，r，t）（各向同性情形).", "confidence": 0.9330995321273804}, {"box": [[539.0, 691.0], [583.0, 691.0], [583.0, 708.0], [539.0, 708.0]], "text": "(1.3')", "confidence": 0.8865294009447098}, {"box": [[81.0, 713.0], [584.0, 713.0], [584.0, 732.0], [81.0, 732.0]], "text": "上面我们用了球坐标系中的θ、来表示传播方向k，立体角元dΩ=sinθ", "confidence": 0.9729323246899773}, {"box": [[79.0, 736.0], [584.0, 735.0], [584.0, 757.0], [79.0, 758.0]], "text": "dθdp.u（v,r,t）的单位是J/(m²·Hz)[焦耳/（米3·赫兹）]或erg/(cm²", "confidence": 0.8751253828089288}, {"box": [[80.0, 763.0], [584.0, 763.0], [584.0, 781.0], [80.0, 781.0]], "text": "·Hz)[尔格/（厘米”·赫兹）]；U(r，t）的单位是J/m²（焦耳／米3）或", "confidence": 0.9182464510202408}, {"box": [[105.0, 812.0], [584.0, 812.0], [584.0, 831.0], [105.0, 831.0]], "text": "我们可以拿气体分子的速度分布函数f（v，r，t）和这里的辐射能分布函数", "confidence": 0.9723646853651319}, {"box": [[79.0, 829.0], [584.0, 829.0], [584.0, 848.0], [79.0, 848.0]], "text": "f（v，k，r，t）作一比较。这里的k相当于速度的方向，v相当于速度的大小，或者更确", "confidence": 0.9684025134359088}, {"box": [[80.0, 847.0], [585.0, 847.0], [585.0, 865.0], [80.0, 865.0]], "text": "切地说，相当于分子动量的大小或动能。如果我们把辐射场看成光子气的话，以上类比", "confidence": 0.9995194108862626}, {"box": [[80.0, 864.0], [583.0, 864.0], [583.0, 882.0], [80.0, 882.0]], "text": "的意义就更清楚了，因为光子动量的大小p=hv/c，能量e=hv，但速度的大小永远是", "confidence": 0.9791098077122758}, {"box": [[81.0, 882.0], [157.0, 882.0], [157.0, 898.0], [81.0, 898.0]], "text": "c，没有分布。", "confidence": 0.983264514378139}]