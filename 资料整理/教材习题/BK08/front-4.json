[{"box": [[345.0, 114.0], [372.0, 114.0], [372.0, 138.0], [345.0, 138.0]], "text": "序", "confidence": 0.9992077946662903}, {"box": [[138.0, 177.0], [611.0, 177.0], [611.0, 195.0], [138.0, 195.0]], "text": "从教学顺序上看，本书是《新概念物理教程》中的第五卷，全套书各卷", "confidence": 0.9993083861566359}, {"box": [[107.0, 201.0], [611.0, 201.0], [611.0, 219.0], [107.0, 219.0]], "text": "的编写和改革思路是一脉相承的，但根据内容的特点，本卷更加强调用普通", "confidence": 0.9994719913511565}, {"box": [[108.0, 226.0], [306.0, 226.0], [306.0, 242.0], [108.0, 242.0]], "text": "物理课的风格讲述量子物理。", "confidence": 0.9987097474244925}, {"box": [[137.0, 248.0], [610.0, 248.0], [610.0, 266.0], [137.0, 266.0]], "text": "本书不是“量子力学”教材。本书由实验事实出发，从特殊到一般引入", "confidence": 0.9981083350796853}, {"box": [[107.0, 273.0], [611.0, 273.0], [611.0, 291.0], [107.0, 291.0]], "text": "一些概念，较多地注重形象化和直观性，不追求逻辑上的严格性和理论上的", "confidence": 0.9992408174456973}, {"box": [[108.0, 297.0], [610.0, 297.0], [610.0, 313.0], [108.0, 313.0]], "text": "完整性和系统性。在数学工具上，本书几乎从头起就运用狄拉克符号和矩", "confidence": 0.9976062122732401}, {"box": [[105.0, 318.0], [611.0, 319.0], [611.0, 338.0], [105.0, 337.0]], "text": "阵来表示，采用了与通常量子力学中以偏微分方程为基础所不同的甚至颠", "confidence": 0.9987953882664442}, {"box": [[107.0, 343.0], [611.0, 343.0], [611.0, 361.0], [107.0, 361.0]], "text": "倒了的讲述体系。书中只介绍量子力学的基本概念和架构，不涉及量子力学", "confidence": 0.9996529095100634}, {"box": [[107.0, 367.0], [611.0, 367.0], [611.0, 385.0], [107.0, 385.0]], "text": "中许多基本而重要的计算方法。所以，物理专业的学生在学习了本卷教材之", "confidence": 0.999538829832366}, {"box": [[107.0, 415.0], [612.0, 415.0], [612.0, 433.0], [107.0, 433.0]], "text": "时，我们往往遇到一个困难，即有些重要课程，如固体物理、原子核物理等，", "confidence": 0.9990971228655647}, {"box": [[107.0, 438.0], [611.0, 438.0], [611.0, 457.0], [107.0, 457.0]], "text": "需要等待量子力学课先行而不得不排得相当靠后。我们相信，在学生读了本", "confidence": 0.9915913849165945}, {"box": [[107.0, 461.0], [611.0, 461.0], [611.0, 479.0], [107.0, 479.0]], "text": "卷教材之后，上述课程就不必等量子力学之后再开设了，这将给教学计划的", "confidence": 0.9995326363679135}, {"box": [[107.0, 485.0], [610.0, 485.0], [610.0, 503.0], [107.0, 503.0]], "text": "制订带来相当大的灵活性。此外，本卷教材的学习，也对物理类专业的学生", "confidence": 0.9994968988678672}, {"box": [[108.0, 510.0], [291.0, 510.0], [291.0, 526.0], [108.0, 526.0]], "text": "做近代物理实验大有帮助。", "confidence": 0.9999115963776907}, {"box": [[137.0, 533.0], [611.0, 533.0], [611.0, 551.0], [137.0, 551.0]], "text": "传统上普通物理课的第五部分是“原子物理”，本书与原子物理教材也", "confidence": 0.9990689466076512}, {"box": [[107.0, 557.0], [611.0, 557.0], [611.0, 575.0], [107.0, 575.0]], "text": "大有区别。本书一改国内多年来原子物理教材以原子光谱和玻尔旧量子论", "confidence": 0.9995846319943666}, {"box": [[108.0, 581.0], [610.0, 581.0], [610.0, 597.0], [108.0, 597.0]], "text": "为主线的模式，而是从头起就用量子力学的基本概念和语言，较全面地介绍", "confidence": 0.9992574959090261}, {"box": [[107.0, 603.0], [610.0, 603.0], [610.0, 621.0], [107.0, 621.0]], "text": "了当代量子物理的方方面面，除原子物理课程传统内容外，还介绍了诸如量", "confidence": 0.9995427185838873}, {"box": [[107.0, 627.0], [611.0, 627.0], [611.0, 645.0], [107.0, 645.0]], "text": "子共振、势垒隧穿、能带、半导体、声子与元激发、超导体、AB效应、约瑟夫", "confidence": 0.9989134805543082}, {"box": [[107.0, 651.0], [611.0, 651.0], [611.0, 669.0], [107.0, 669.0]], "text": "森结、分子轨函及其杂化等，并作为窗口，简单介绍了量子态交缠、薛定谔猫", "confidence": 0.9924154509516323}, {"box": [[107.0, 675.0], [611.0, 675.0], [611.0, 693.0], [107.0, 693.0]], "text": "态的实验实现、贝尔不等式实验检验、量子隐形传态与量子计算等近年来量", "confidence": 0.9995620413260027}, {"box": [[106.0, 698.0], [611.0, 699.0], [611.0, 718.0], [106.0, 717.0]], "text": "子物理的最新进展。但是从课程的衔接来说，本书只要求读者学过普通物理", "confidence": 0.9991155483505942}, {"box": [[106.0, 722.0], [606.0, 722.0], [606.0, 742.0], [106.0, 741.0]], "text": "的光学部分、微积分和线性代数。对学时的要求和原子物理课程大致相仿。", "confidence": 0.9997682643659187}, {"box": [[135.0, 745.0], [611.0, 746.0], [611.0, 765.0], [135.0, 764.0]], "text": "20世纪是科学技术空前迅猛发展的世纪，在此世纪内，人类社会在科", "confidence": 0.9997556151882294}, {"box": [[107.0, 770.0], [611.0, 770.0], [611.0, 788.0], [107.0, 788.0]], "text": "技进步上经历了一个又一个划时代的变革。继19世纪的物理学把人类社", "confidence": 0.9983815867453814}, {"box": [[108.0, 794.0], [611.0, 794.0], [611.0, 812.0], [108.0, 812.0]], "text": "会带进“电气化时代”以后，20世纪40年代物理学又使人类掌握了核能的", "confidence": 0.9933280594208661}, {"box": [[107.0, 818.0], [611.0, 818.0], [611.0, 836.0], [107.0, 836.0]], "text": "奥秘，把人类社会带进“原子时代”。今天核技术的应用远不止于为社会提供", "confidence": 0.9965802957029903}, {"box": [[107.0, 842.0], [611.0, 842.0], [611.0, 860.0], [107.0, 860.0]], "text": "长久可靠的能源，放射性与核磁共振在医学上的诊断与治疗作用，已几乎家", "confidence": 0.9987241138111461}, {"box": [[107.0, 865.0], [610.0, 865.0], [610.0, 884.0], [107.0, 884.0]], "text": "喻户晓。20世纪五六十年代物理学家又发明了激光，现在激光已广泛应用", "confidence": 0.9974867918274619}, {"box": [[107.0, 889.0], [611.0, 889.0], [611.0, 907.0], [107.0, 907.0]], "text": "于尖端科学研究、工业、农业、医学、通讯、计算、军事和家庭生活。20世纪科", "confidence": 0.9996708912981881}]