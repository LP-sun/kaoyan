[{"box": [[96.0, 68.0], [110.0, 68.0], [110.0, 80.0], [96.0, 80.0]], "text": "Ⅱ", "confidence": 0.7570353746414185}, {"box": [[329.0, 65.0], [345.0, 65.0], [345.0, 80.0], [329.0, 80.0]], "text": "序", "confidence": 0.9989449381828308}, {"box": [[85.0, 105.0], [589.0, 105.0], [589.0, 123.0], [85.0, 123.0]], "text": "学技术给人类社会所带来最大的冲击，莫过于以现代计算机为基础发展起", "confidence": 0.9996990486979485}, {"box": [[84.0, 127.0], [590.0, 126.0], [590.0, 146.0], [84.0, 146.0]], "text": "来的电子信息技术。号称“信息时代”的到来被誉为“第三次产业革命”。的", "confidence": 0.9937591342365041}, {"box": [[85.0, 152.0], [589.0, 152.0], [589.0, 170.0], [85.0, 170.0]], "text": "确，计算机给人类社会带来如此深刻的变化，是二三十年前任何有远见的科", "confidence": 0.9997175444256176}, {"box": [[85.0, 176.0], [590.0, 176.0], [590.0, 194.0], [85.0, 194.0]], "text": "学家都不可能预见到的。现代计算机的硬件基础是半导体集成电路，PN结", "confidence": 0.9996131134755684}, {"box": [[85.0, 200.0], [590.0, 200.0], [590.0, 218.0], [85.0, 218.0]], "text": "是核心。1947年晶体管的发明，标志着信息时代的发端。所有上述一切，无", "confidence": 0.9979281697954451}, {"box": [[85.0, 224.0], [590.0, 224.0], [590.0, 242.0], [85.0, 242.0]], "text": "不建立在量子物理的基础上，或是在量子物理的概念中衍生出来的。此外，", "confidence": 0.9995422002040979}, {"box": [[85.0, 247.0], [590.0, 247.0], [590.0, 265.0], [85.0, 265.0]], "text": "众多交叉学科的领域，像量子化学、量子生物学、量子宇宙学，也都立足于量", "confidence": 0.9930556749596315}, {"box": [[86.0, 271.0], [590.0, 271.0], [590.0, 289.0], [86.0, 289.0]], "text": "子物理这块奠基石上。我们可以毫不夸大地说，没有量子物理，就没有我们", "confidence": 0.9975813266002771}, {"box": [[86.0, 296.0], [212.0, 296.0], [212.0, 312.0], [86.0, 312.0]], "text": "今天的生活方式。", "confidence": 0.9999015182256699}, {"box": [[113.0, 319.0], [589.0, 319.0], [589.0, 337.0], [113.0, 337.0]], "text": "今年是普朗克的量子论诞生100周年，从1925年或1926年算起量子力", "confidence": 0.9993305018969945}, {"box": [[85.0, 341.0], [589.0, 341.0], [589.0, 360.0], [85.0, 360.0]], "text": "学的建立也近3/4个世纪了。然面时至今日，我们的基础物理课中量子物理", "confidence": 0.987905789824093}, {"box": [[86.0, 366.0], [590.0, 366.0], [590.0, 384.0], [86.0, 384.0]], "text": "的内容在许多地方只一带而过，即使在“原子物理”部分，如何处理旧量子", "confidence": 0.98909981323011}, {"box": [[86.0, 414.0], [591.0, 414.0], [591.0, 432.0], [86.0, 432.0]], "text": "代”了。像量子物理这样重要的内容，在基础物理课程中应占有适当的地", "confidence": 0.9982088822871447}, {"box": [[87.0, 438.0], [589.0, 438.0], [589.0, 454.0], [87.0, 454.0]], "text": "位。这个问题之所以迟迟不能解决，是因为以偏微分方程为基础的那套量子", "confidence": 0.9909532485586224}, {"box": [[86.0, 460.0], [590.0, 459.0], [590.0, 478.0], [86.0, 479.0]], "text": "力学理论体系，对学生预备知识的要求实在太高了。固然准备学物理的学生", "confidence": 0.9996412811857281}, {"box": [[87.0, 485.0], [590.0, 485.0], [590.0, 503.0], [87.0, 503.0]], "text": "可以等到高年级再学量子力学，但是对于大多数非物理专业的学生来说，基", "confidence": 0.9992921930370908}, {"box": [[87.0, 509.0], [590.0, 509.0], [590.0, 527.0], [87.0, 527.0]], "text": "础物理课是他们的最后一门物理课。科学家预言，在21世纪中，对于我们的", "confidence": 0.9987510600510765}, {"box": [[86.0, 532.0], [591.0, 531.0], [591.0, 550.0], [86.0, 551.0]], "text": "孩子和孩子的孩子来说，量子力学的概念将成为一种常识。若上述情况长此", "confidence": 0.9991850943276377}, {"box": [[87.0, 556.0], [591.0, 556.0], [591.0, 575.0], [87.0, 575.0]], "text": "以往，那怎么可能？话又说回来，考入大学物理系的学生，许多是中学里的", "confidence": 0.998249888420105}, {"box": [[86.0, 579.0], [591.0, 578.0], [591.0, 597.0], [86.0, 598.0]], "text": "依依者，他们对物理，特别是近代物理的各种激动人心的成就，满怀激情和", "confidence": 0.975173912265084}, {"box": [[87.0, 604.0], [591.0, 604.0], [591.0, 622.0], [87.0, 622.0]], "text": "兴趣。如果进得大学大门来，两年之内尽和一些滑轮、斜面和经典电路之类", "confidence": 0.996229193427346}, {"box": [[87.0, 628.0], [591.0, 628.0], [591.0, 646.0], [87.0, 646.0]], "text": "的东西打交道，他们会不会感到失望？兴趣是最好的老师，如果量子物理教", "confidence": 0.9979095531232429}, {"box": [[88.0, 653.0], [585.0, 653.0], [585.0, 668.0], [88.0, 668.0]], "text": "得能激发和保持学生的兴趣，将有助于他们克服学习量子力学的困难。款形", "confidence": 0.9518467666524829}, {"box": [[118.0, 675.0], [591.0, 675.0], [591.0, 693.0], [118.0, 693.0]], "text": "对于多数需要懂点量子物理的人（包括实验物理工作者、电子学工程师", "confidence": 0.9889366588284892}, {"box": [[87.0, 699.0], [591.0, 699.0], [591.0, 717.0], [87.0, 717.0]], "text": "和化学家）来说，需要的只是量子力学的基本概念和架构，而那套用微分方", "confidence": 0.9960304191618254}, {"box": [[88.0, 723.0], [591.0, 723.0], [591.0, 741.0], [88.0, 741.0]], "text": "程处理问题的方法并不真正用得着。能否绕过传统的那套以偏微分方程为", "confidence": 0.9981567040085793}, {"box": [[88.0, 747.0], [591.0, 747.0], [591.0, 765.0], [88.0, 765.0]], "text": "主线的量子力学教学体系，使量子力学的基本概念和架构能为低年级学生", "confidence": 0.9986864849925041}, {"box": [[88.0, 770.0], [592.0, 770.0], [592.0, 789.0], [88.0, 789.0]], "text": "所接受？20世纪60年代物理大师费曼迈出了第一步，《费曼物理学讲义》", "confidence": 0.9973587288576014}, {"box": [[89.0, 795.0], [405.0, 795.0], [405.0, 811.0], [89.0, 811.0]], "text": "第三卷成了我们编写此书时的启蒙课本。出（", "confidence": 0.9527454301714897}, {"box": [[112.0, 847.0], [591.0, 846.0], [591.0, 865.0], [112.0, 866.0]], "text": "应该说，狄拉克的《量子力学》（1930年第一版，1956第四版）是用符号方法代替", "confidence": 0.9950077906250954}, {"box": [[88.0, 867.0], [592.0, 867.0], [592.0, 886.0], [88.0, 886.0]], "text": "偏微分方程来阐述量子力学原理的第一本教材。不过那本书不是为初学者写的，但我们", "confidence": 0.9905996918678284}, {"box": [[89.0, 889.0], [259.0, 889.0], [259.0, 905.0], [89.0, 905.0]], "text": "还是从其中吸取了不少营养。", "confidence": 0.9995186420587393}]