[{"box": [[348.0, 67.0], [366.0, 67.0], [366.0, 83.0], [348.0, 83.0]], "text": "序", "confidence": 0.9867225289344788}, {"box": [[585.0, 70.0], [597.0, 70.0], [597.0, 83.0], [585.0, 83.0]], "text": "Ⅲ", "confidence": 0.6143115758895874}, {"box": [[137.0, 107.0], [607.0, 107.0], [607.0, 125.0], [137.0, 125.0]], "text": "费曼胆识过人之处，在于他敢于把传统的量子力学教学顺序倒过来。他", "confidence": 0.9993578830072957}, {"box": [[107.0, 130.0], [608.0, 130.0], [608.0, 149.0], [107.0, 149.0]], "text": "一开头就介绍量子力学最基本、最普遍的特征，从概率幅和量子态的概念切", "confidence": 0.9994723146611993}, {"box": [[107.0, 154.0], [609.0, 154.0], [609.0, 172.0], [107.0, 172.0]], "text": "入，讲它们的叠加、分解和干涉，并用非常普遍但有点抽象的狄拉克符号来", "confidence": 0.9975287968462164}, {"box": [[106.0, 178.0], [609.0, 178.0], [609.0, 196.0], [106.0, 196.0]], "text": "描述它们。他从矩阵代数入手，代替通常的微分方程体系。对于从中学出来", "confidence": 0.9989188295422178}, {"box": [[108.0, 203.0], [608.0, 203.0], [608.0, 218.0], [108.0, 218.0]], "text": "不久的学生来说，矩阵运算比偏微分方程容易多了。这样一来，自旋的概念", "confidence": 0.9976168563871672}, {"box": [[106.0, 225.0], [609.0, 225.0], [609.0, 243.0], [106.0, 243.0]], "text": "就可以从通常排在较后的地方提到前面，为进一步讨论双态系统提供重要", "confidence": 0.9998012203723192}, {"box": [[106.0, 249.0], [609.0, 249.0], [609.0, 267.0], [106.0, 267.0]], "text": "的实例。我们认为，费曼的书最精彩的地方是他引用了大量的双态系统。从", "confidence": 0.9952866760167208}, {"box": [[106.0, 272.0], [609.0, 272.0], [609.0, 290.0], [106.0, 290.0]], "text": "微分方程的体系看，最简单的量子系统是一维系统，但双态系统却是更简单", "confidence": 0.9941843495224462}, {"box": [[106.0, 296.0], [610.0, 296.0], [610.0, 314.0], [106.0, 314.0]], "text": "的量子系统。处理这类系统用不着微分方程，但要用矩阵代数。从氨分子翻", "confidence": 0.9994024056376833}, {"box": [[106.0, 320.0], [610.0, 320.0], [610.0, 338.0], [106.0, 338.0]], "text": "转分裂到苯分子的共振能和染料分子的共轭双键，从氨分子钟到核磁共振，", "confidence": 0.9989139798915747}, {"box": [[107.0, 344.0], [609.0, 344.0], [609.0, 362.0], [107.0, 362.0]], "text": "费曼能够为双态系统找到那么多有趣而富有实际意义的例子，颇令我们惊", "confidence": 0.991516487672925}, {"box": [[107.0, 367.0], [608.0, 367.0], [608.0, 385.0], [107.0, 385.0]], "text": "叹和折服。并非自然界本来就有许多现成的双态系统，而是费曼一反量子力", "confidence": 0.9943041349902297}, {"box": [[106.0, 390.0], [609.0, 390.0], [609.0, 408.0], [106.0, 408.0]], "text": "学教学顺序的常规。通常在量子力学中讲原子能级的顺序是从主量子数到", "confidence": 0.9995252843946218}, {"box": [[107.0, 414.0], [609.0, 414.0], [609.0, 432.0], [107.0, 432.0]], "text": "角量子数，再到磁量子数（塞曼分裂)，从能级的精细结构到超精细结构；讲", "confidence": 0.9777388660346761}, {"box": [[107.0, 438.0], [609.0, 438.0], [609.0, 456.0], [107.0, 456.0]], "text": "分子能级的顺序是从电子能级到振动能级，然后再到转动能级。费曼却从级", "confidence": 0.9990246350114996}, {"box": [[108.0, 463.0], [608.0, 463.0], [608.0, 478.0], [108.0, 478.0]], "text": "差最小的能级（如氨分子特定的转动能级，或氢原子的塞曼分裂能级和超精", "confidence": 0.997604231039683}, {"box": [[107.0, 485.0], [609.0, 485.0], [609.0, 503.0], [107.0, 503.0]], "text": "细结构能级）开始，然后再在以后章节里逐渐扩展到大级差的基本能级。由", "confidence": 0.9992860104098464}, {"box": [[107.0, 508.0], [610.0, 508.0], [610.0, 527.0], [107.0, 527.0]], "text": "于能级钜细有多个数量级之差，把一对级差细微的能级孤立出来研究就成", "confidence": 0.9993659891188145}, {"box": [[107.0, 532.0], [608.0, 532.0], [608.0, 550.0], [107.0, 550.0]], "text": "为可能。这便是费曼书中双态系统的由来。我们体会，从双态系统入手，一方", "confidence": 0.9995767263805165}, {"box": [[107.0, 556.0], [610.0, 556.0], [610.0, 574.0], [107.0, 574.0]], "text": "面可以使学生较早地建立起态矢空间和表象变换等概念，这些量子力学的", "confidence": 0.9898835625499487}, {"box": [[107.0, 580.0], [609.0, 580.0], [609.0, 598.0], [107.0, 598.0]], "text": "基本架构本来是很抽象的，在微分方程的体系中只能放在课程中比较靠后", "confidence": 0.9992515929043293}, {"box": [[107.0, 604.0], [611.0, 604.0], [611.0, 622.0], [107.0, 622.0]], "text": "的地方讲，有些量子力学的简明教程甚至略去不讲。但对于双态系统来说，", "confidence": 0.9957422288981351}, {"box": [[107.0, 627.0], [610.0, 627.0], [610.0, 646.0], [107.0, 646.0]], "text": "希尔伯特空间约化成二维，无论态基的变换还是本征值、本征矢的求得，在", "confidence": 0.9982268394845905}, {"box": [[107.0, 650.0], [610.0, 650.0], [610.0, 668.0], [107.0, 668.0]], "text": "数学上都没有什么困难。另一方面，从双态系统入手，可使学生在本课程中", "confidence": 0.9996653163071835}, {"box": [[107.0, 674.0], [610.0, 674.0], [610.0, 692.0], [107.0, 692.0]], "text": "尽早地接触到量子物理里激动人心的最新成果，有助于激发学生学习的热", "confidence": 0.9990836828947067}, {"box": [[107.0, 699.0], [135.0, 699.0], [135.0, 716.0], [107.0, 716.0]], "text": "情。", "confidence": 0.9986690282821655}, {"box": [[137.0, 721.0], [609.0, 721.0], [609.0, 739.0], [137.0, 739.0]], "text": "费曼的书远非完美无瑕。费曼坦率地承认，对于教本科生基础课，他是", "confidence": 0.9987870781652389}, {"box": [[107.0, 746.0], [611.0, 746.0], [611.0, 764.0], [107.0, 764.0]], "text": "没有经验的，他在加州理工学院唯一的这次为大学本科二年级学生的讲授", "confidence": 0.9997359067201614}, {"box": [[107.0, 769.0], [609.0, 769.0], [609.0, 787.0], [107.0, 787.0]], "text": "并不理想。我们也感到，他这本书中许多地方教学上的处理大有可斟酌之", "confidence": 0.9911416210234165}, {"box": [[107.0, 793.0], [610.0, 793.0], [610.0, 811.0], [107.0, 811.0]], "text": "处。不仅如此，在我们较深入地钻研了他这本教材之后，发现其中科学性的", "confidence": 0.9996131134755684}, {"box": [[107.0, 817.0], [610.0, 817.0], [610.0, 835.0], [107.0, 835.0]], "text": "欠妥和失误之处，并不是个别的。总起来看，当然是瑕不掩瑜。但如果我们东", "confidence": 0.9986994231448454}, {"box": [[107.0, 841.0], [611.0, 841.0], [611.0, 859.0], [107.0, 859.0]], "text": "施效擎，就会弄巧成拙，到头来自己吃苦头。所以我们为编写自已的这本教", "confidence": 0.9678475694222883}, {"box": [[108.0, 865.0], [611.0, 865.0], [611.0, 883.0], [108.0, 883.0]], "text": "材，在借用费曼光辉思想的同时，花了很大的工夫进行了一番艰苦的再创", "confidence": 0.9973763935267925}, {"box": [[106.0, 886.0], [408.0, 887.0], [408.0, 906.0], [106.0, 905.0]], "text": "造，其中还包含了与同行们认真切磋的成果。", "confidence": 0.9816336423158646}]